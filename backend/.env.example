# Local development overrides for the service. Every one is optional — the
# defaults in service/settings.py are what runs.
#
# This file is a template. Real values for the deployed host are set in
# ../infra/compose.yml; operator credentials live in the gitignored .env at the
# repository root, one level up.

# Require X-API-Key on /api/convert. Unset means the endpoint is OPEN, which is
# how it is deployed: the bundled demo page sends no key.
# PW_API_KEY=

# Comma-separated CORS allowlist. Empty means same-origin only.
# PW_ALLOWED_ORIGINS=https://coronring.github.io

# Upload and image limits
# PW_MAX_UPLOAD_BYTES=8388608
# PW_MAX_IMAGE_PIXELS=40000000
# PW_MAX_IMAGE_DIMENSION=12000

# Cost control
# PW_MAX_CONCURRENCY=2
# PW_CONVERT_TIMEOUT_S=60
# PW_RATE_LIMIT_PER_MIN=20
# PW_RATE_LIMIT_BURST=6

# Set to 0 when running with no reverse proxy in front, where X-Forwarded-For
# would be attacker-controlled rather than set by a trusted hop.
# PW_TRUST_FORWARDED_FOR=1

# PW_LOG_LEVEL=info
