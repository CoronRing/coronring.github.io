---
/**
 * Resume — experience, education, achievements, certifications.
 *
 * A single hairline-separated timeline rather than a stack of cards. Cards
 * imply each entry is a destination; a resume is a list you scan top to
 * bottom, and borders between every row are visual noise.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Reveal from '../components/ui/Reveal.astro';
import { monthYear } from '../lib/format';

type Entry = CollectionEntry<'experience'>;

const all = await getCollection('experience');

/** Newest first; entries with no `end` (current roles) sort to the top. */
function byRecency(a: Entry, b: Entry): number {
  const aEnd = a.data.end?.getTime() ?? Number.POSITIVE_INFINITY;
  const bEnd = b.data.end?.getTime() ?? Number.POSITIVE_INFINITY;
  if (aEnd !== bEnd) return bEnd - aEnd;
  return b.data.start.getTime() - a.data.start.getTime();
}

const SECTIONS = [
  { kind: 'work', title: 'Experience' },
  { kind: 'education', title: 'Education' },
  { kind: 'award', title: 'Achievements' },
  { kind: 'certification', title: 'Certifications' },
] as const;

const grouped = SECTIONS.map((section) => ({
  ...section,
  entries: all.filter((e) => e.data.kind === section.kind).sort(byRecency),
})).filter((section) => section.entries.length > 0);

function period(entry: Entry): string {
  const start = monthYear(entry.data.start);
  return `${start} — ${entry.data.end ? monthYear(entry.data.end) : 'Present'}`;
}
---

<PageLayout
  eyebrow="Resume"
  title="Resume"
  description="Experience, education, achievements, and certifications."
  lede="The condensed version. The projects page has the actual artifacts."
>
  <a
    slot="action"
    href="/resume.pdf"
    class="border-line hover:border-fg inline-flex h-10 items-center gap-2 border px-4 text-sm transition-colors"
  >
    Download PDF
    <Icon name="arrow-up-right" size={14} />
  </a>

  {
    grouped.length > 0 ? (
      <div class="space-y-16">
        {grouped.map((section) => (
          <section aria-labelledby={`s-${section.kind}`}>
            <h2 id={`s-${section.kind}`} class="eyebrow eyebrow-marked">
              {section.title}
            </h2>

            <ul class="divide-line mt-6 divide-y">
              {section.entries.map((entry, i) => (
                <Reveal as="li" delay={i * 50}>
                  <div class="grid gap-2 py-7 sm:grid-cols-[10rem_1fr] sm:gap-8">
                    <p class="text-faint tabular pt-1 font-mono text-[11px]">
                      {period(entry)}
                      {entry.data.location && <span class="mt-1 block">{entry.data.location}</span>}
                    </p>

                    <div>
                      <h3 class="text-lg">{entry.data.role}</h3>
                      <p class="text-accent mt-1 text-sm">{entry.data.organization}</p>

                      {entry.data.highlights.length > 0 && (
                        <ul class="text-muted mt-4 space-y-2 text-sm leading-relaxed">
                          {entry.data.highlights.map((h) => (
                            <li class="flex gap-3">
                              <span
                                aria-hidden="true"
                                class="bg-accent-fill mt-[0.5em] size-1 shrink-0"
                              />
                              <span>{h}</span>
                            </li>
                          ))}
                        </ul>
                      )}

                      {entry.data.tech.length > 0 && (
                        <p class="text-faint mt-4 font-mono text-[10px] tracking-wide uppercase">
                          {entry.data.tech.join(' · ')}
                        </p>
                      )}
                    </div>
                  </div>
                </Reveal>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <p class="text-muted text-sm">
        No entries yet. Add Markdown files under{' '}
        <code class="text-accent font-mono">src/content/experience/</code>.
      </p>
    )
  }
</PageLayout>
