---
/**
 * Read Time tool page.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import ReadTime from '../../components/tools/ReadTime';
---

<ToolLayout slug="read-time">
  <ReadTime client:load />

  <Fragment slot="about">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">01 · Empirical Reading Rates</h3>
        <p class="text-muted text-sm leading-relaxed">
          Replaces folk &ldquo;200 wpm&rdquo; rules with Brysbaert (2019) meta-analysis baselines
          (238 wpm silent, 183 wpm aloud, 130 wpm presentation).
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Precision: Independent per-sentence pause modeling.
        </div>
      </div>

      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">02 · Zero-Audio Voice Probe</h3>
        <p class="text-muted text-sm leading-relaxed">
          Measures your exact local SpeechSynthesis voice engine. Probes word boundary timestamps at
          2.5x speed muted, extrapolating the entire script in 2 seconds.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Timing: Wall-clock normalized to fix browser timestamp quirks.
        </div>
      </div>

      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">03 · Multilingual & Readability</h3>
        <p class="text-muted text-sm leading-relaxed">
          Applies language-specific pacing factors (German compounding, CJK character ratios) and
          computes Flesch-Kincaid grade scores on English prose.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Output: Dual estimate & measurement readouts.
        </div>
      </div>
    </div>

    <div class="hud-card border-warn mt-6 border-l-2 p-5">
      <h3 class="eyebrow text-warn mb-3">Operational Limits & Assumptions</h3>
      <ul class="text-muted grid gap-3 text-xs leading-relaxed sm:grid-cols-2">
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Boundary Sampling:</strong> Extrapolation assumes uniform register; full linear pass
            is available for mixed text.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Browser Speech API:</strong> Mobile WebKit or restricted engines without <code
              >boundary</code
            > events fall back to empirical models.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Local vs Cloud Voices:</strong> Device-local synthetic voices provide zero-latency
            measurement; cloud voices incorporate network round trips.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Readability Constraints:</strong> Flesch formulas are English-only and intentionally
            disabled on non-Latin scripts.</span
          >
        </li>
      </ul>
    </div>
  </Fragment>
</ToolLayout>
