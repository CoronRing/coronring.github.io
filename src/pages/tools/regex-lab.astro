---
/**
 * Regex Lab tool page.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import RegexLab from '../../components/tools/RegexLab';
---

<ToolLayout slug="regex-lab">
  <RegexLab client:load />

  <Fragment slot="about">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">01 · Four Analysis Modes</h3>
        <p class="text-muted text-sm leading-relaxed">
          Unified workbench covering in-place syntax matches with capture groups, live replacement
          counters, dual-list line filtering (<code>grep -v</code>), and tokenized explanation
          trees.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Precision: Uses ECMAScript <code>d</code> flag indices.
        </div>
      </div>

      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">02 · Catastrophic Backtracking Guard</h3>
        <p class="text-muted text-sm leading-relaxed">
          Detects dangerous nested unbounded quantifiers (e.g. <code>(a+)+b</code>) statically
          before execution, holding dangerous patterns behind an explicit run confirmation.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Protection: Prevents tab lockup and lost drafts.
        </div>
      </div>

      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">03 · Zero-Length Edge Cases</h3>
        <p class="text-muted text-sm leading-relaxed">
          Correctly steps forward on zero-length matches (like <code>\b</code>) using Unicode
          code-point increments to prevent infinite loops and surrogate pair splits.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Robustness: Automatic 1.5-second execution deadline.
        </div>
      </div>
    </div>

    <div class="hud-card border-warn mt-6 border-l-2 p-5">
      <h3 class="eyebrow text-warn mb-3">Operational Limits & Assumptions</h3>
      <ul class="text-muted grid gap-3 text-xs leading-relaxed sm:grid-cols-2">
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>JavaScript Regex Dialect:</strong> Uses browser V8 RegExp semantics; PCRE features
            like possessive quantifiers or <code>\K</code> are not supported.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Safety Budgets:</strong> Processing is bounded at 400,000 characters and 5,000 matches
            with execution timeout enforcement.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Heuristic Warnings:</strong> ReDoD static checks target the most common polynomial/exponential
            structures; subtle backtracking patterns may bypass detection.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Explain Limitations:</strong> Explanation view is a linear token scanner rather than
            a full AST compiler.</span
          >
        </li>
      </ul>
    </div>
  </Fragment>
</ToolLayout>
