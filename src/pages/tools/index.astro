---
/**
 * Tools index — browser-local utilities for LLM work.
 *
 * Flat grid, no group headings: the category is on each card, and dividers at
 * this count cost more vertical space than the grouping saves. Live tools sort
 * first; planned ones
 * stay visible because a roadmap is more honest than a short list.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import Reveal from '../../components/ui/Reveal.astro';
import { TOOLS, TOOL_GROUPS } from '../../data/tools';
import { href } from '../../lib/url';

const tools = [...TOOLS].sort((a, b) => (a.status === b.status ? 0 : a.status === 'live' ? -1 : 1));
const liveCount = TOOLS.filter((t) => t.status === 'live').length;
---

<PageLayout
  eyebrow="Tools"
  title="Tools"
  description="Small, fast, browser-local utilities for working with language models."
  lede="Small instruments for language-model work, and one that runs Python. Almost all of it happens in your browser: what you paste is not uploaded, and every tool that touches the network says on its own page exactly what it touches."
>
  <p slot="action" class="text-faint font-mono text-[11px]">
    <span class="text-ok">{liveCount} live</span> · {TOOLS.length - liveCount} planned
  </p>

  <ul class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
    {
      tools.map((tool, i) => {
        const live = tool.status === 'live';
        const Tag = live ? 'a' : 'div';
        return (
          <Reveal as="li" delay={(i % 3) * 70}>
            <Tag
              href={live ? href(`/tools/${tool.slug}`) : undefined}
              class:list={[
                'group border-line bg-surface relative flex h-full flex-col border p-5',
                live ? 'hover:border-fg transition-colors' : 'opacity-55',
              ]}
            >
              <div class="flex items-center justify-between">
                <span class="eyebrow">{TOOL_GROUPS[tool.group]}</span>
                {live ? (
                  <Icon
                    name="arrow-up-right"
                    size={15}
                    class="text-faint group-hover:text-accent transition-colors"
                  />
                ) : (
                  <span class="text-faint font-mono text-[10px] uppercase">planned</span>
                )}
              </div>

              <h2 class="group-hover:text-accent mt-4 font-mono text-lg transition-colors">
                {tool.name}
              </h2>
              <p class="text-muted mt-2 flex-1 text-sm leading-relaxed">{tool.summary}</p>

              {live && (
                <p class="text-faint mt-4 flex items-center gap-1.5 font-mono text-[10px]">
                  <span
                    aria-hidden="true"
                    class:list={['size-1.5 rounded-full', tool.offline ? 'bg-ok' : 'bg-warn']}
                  />
                  {tool.offline ? 'fully offline' : 'makes network requests'}
                </p>
              )}

              {live && (
                <span class="bg-accent-fill mt-4 h-[3px] w-10 transition-[width] duration-[var(--dur-base)] group-hover:w-16" />
              )}
            </Tag>
          </Reveal>
        );
      })
    }
  </ul>
</PageLayout>
