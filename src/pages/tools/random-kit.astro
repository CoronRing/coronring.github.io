---
/**
 * Random Kit tool page.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import RandomKit from '../../components/tools/RandomKit';
---

<ToolLayout slug="random-kit">
  <RandomKit client:load />

  <Fragment slot="about">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">01 · Explicit Dual Sources</h3>
        <p class="text-muted text-sm leading-relaxed">
          Replaces biased <code>Math.random()</code> with two explicit choices: deterministic <strong
            >xoshiro128**</strong
          > (reproducible fixtures) or cryptographic <strong>crypto.getRandomValues</strong> (secrets
          & tokens).
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Clarity: Predictability vs secrecy is strictly separated.
        </div>
      </div>

      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">02 · Unbiased Sampling</h3>
        <p class="text-muted text-sm leading-relaxed">
          Switches automatically between rejection sampling and partial Fisher-Yates shuffles based
          on domain density to guarantee uniform distribution without bias.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Validation: Live frequency histogram reveals distribution shape.
        </div>
      </div>

      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">03 · Conforming Formats</h3>
        <p class="text-muted text-sm leading-relaxed">
          Generates compliant RFC 4122 UUID v4 IDs with proper version/variant bitfields, custom
          alphabet strings, list permutations, and multi-sided dice rolls.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Export: JSON, CSV, TSV, or raw delimiter arrays.
        </div>
      </div>
    </div>

    <div class="hud-card border-warn mt-6 border-l-2 p-5">
      <h3 class="eyebrow text-warn mb-3">Operational Limits & Assumptions</h3>
      <ul class="text-muted grid gap-3 text-xs leading-relaxed sm:grid-cols-2">
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Seeded Mode Non-Secrecy:</strong> Any party with the seed string can reproduce every
            draw. Never use seeded mode for production passwords.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Distribution Clamping:</strong> Normal and exponential tails past the specified bounds
            are clamped to endpoint ranges.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Entropy Calculations:</strong> Displayed entropy figures assume uniform symbol selection;
            seeded mode entropy measures character space only.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Batch Limits:</strong> Maximum batch size per generate click is bounded to 100,000
            entries to prevent tab memory thrashing.</span
          >
        </li>
      </ul>
    </div>
  </Fragment>
</ToolLayout>
