---
/**
 * MCP Tester tool page.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import McpTester from '../../components/tools/McpTester';
---

<ToolLayout slug="mcp-tester">
  <McpTester client:load />

  <Fragment slot="about">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">01 · Protocol Ladder</h3>
        <p class="text-muted text-sm leading-relaxed">
          Negotiates modern <code>2026-07-28</code> protocol (<code>server/discover</code>) and
          falls back dynamically to legacy <code>initialize</code> handshakes.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Compatibility: Adapts to older and modern deployed MCP agents.
        </div>
      </div>

      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">02 · Schema & Latency Checks</h3>
        <p class="text-muted text-sm leading-relaxed">
          Validates tool JSON schemas, header annotations, method error codes (<code>-32601</code>),
          cacheability (<code>ttlMs</code>), and multi-sample median latency.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Diagnostic: Generates reproducible <code>curl</code> commands for every step.
        </div>
      </div>

      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">03 · Browser-Direct Execution</h3>
        <p class="text-muted text-sm leading-relaxed">
          Requests dispatch directly from your browser. Allows probing <code>localhost</code> services
          without intermediary proxy server risks.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Privacy: Tokens and endpoints never pass through third-party relays.
        </div>
      </div>
    </div>

    <div class="hud-card border-warn mt-6 border-l-2 p-5">
      <h3 class="eyebrow text-warn mb-3">Operational Limits & Assumptions</h3>
      <ul class="text-muted grid gap-3 text-xs leading-relaxed sm:grid-cols-2">
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>CORS Requirements:</strong> Remote endpoints must permit browser cross-origin requests.
            For blocked endpoints, copy the generated terminal curl.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Live Execution:</strong> Tool invocations are actual live API calls. Destructive
            mutations on production endpoints will execute.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Local Latency:</strong> Timing reflects full browser-to-server network round trips
            rather than isolated backend compute time.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Complex Elicitation:</strong> Multi-turn human-in-the-loop elicitation pauses are
            surfaced as <code>input_required</code>.</span
          >
        </li>
      </ul>
    </div>
  </Fragment>
</ToolLayout>
