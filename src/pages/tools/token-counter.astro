---
/**
 * Token Counter tool page.
 */
import ToolLayout from '../../layouts/ToolLayout.astro';
import TokenCounter from '../../components/tools/TokenCounter';
---

<ToolLayout slug="token-counter">
  <TokenCounter client:load />

  <Fragment slot="about">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">01 · Pricing Catalogue</h3>
        <p class="text-muted text-sm leading-relaxed">
          Aggregates over 2,400 models across 80+ providers from LiteLLM's unified index. Statically
          compiled to eliminate external network requests.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Units: Standardized USD / 1M input, output, and cached tokens.
        </div>
      </div>

      <div class="hud-card p-5">
        <h3 class="eyebrow text-accent mb-2">02 · Segment-Weighted Estimator</h3>
        <p class="text-muted text-sm leading-relaxed">
          Runs entirely in-tab with zero prompt leakage. Uses character-class weighting (code, CJK,
          digits, whitespace) to outperform naive <code>chars/4</code> heuristics.
        </p>
        <div class="text-faint mt-3 font-mono text-[11px]">
          Precision: ±10% on prose, ±15% on code structures.
        </div>
      </div>
    </div>

    <div class="hud-card border-warn mt-6 border-l-2 p-5">
      <h3 class="eyebrow text-warn mb-3">Operational Limits & Assumptions</h3>
      <ul class="text-muted grid gap-3 text-xs leading-relaxed sm:grid-cols-2">
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Budgeting vs Billing:</strong> Ideal for architectural sizing and price projection;
            not for final invoice reconciliation.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>List Pricing:</strong> Excludes volume tier discounts, enterprise commitments, and
            tool call add-on fees.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Cache Reads:</strong> The cache slider applies published cache-read rates and excludes
            one-time cache-write costs.</span
          >
        </li>
        <li class="flex gap-2">
          <span class="text-accent font-mono font-bold">·</span>
          <span
            ><strong>Snapshot Date:</strong> Reflected date indicates the price list sync timestamp.</span
          >
        </li>
      </ul>
    </div>
  </Fragment>
</ToolLayout>
