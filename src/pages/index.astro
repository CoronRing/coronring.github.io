---
/**
 * Home — the index.
 *
 * Three views, one idea each:
 *   Hero          — who, in one sentence, over the particle corona
 *   Capabilities  — a paged carousel; one pillar visible at a time
 *   Selected work — two cards, no more
 *
 * The density budget is deliberate. The previous revision put three buttons,
 * a four-cell readout, three prose cards and a contact panel on one page; a
 * visitor read none of it. The persistent call to action lives in the rail,
 * so the hero needs exactly one.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleField from '../components/decor/ParticleField.astro';
import HudRing from '../components/decor/HudRing.astro';
import Carousel, { type CarouselItem } from '../components/ui/Carousel';
import ProjectCard from '../components/ui/ProjectCard.astro';
import Reveal from '../components/ui/Reveal.astro';
import Icon from '../components/ui/Icon.astro';
import { href } from '../lib/url';

/** Two at most. The projects page exists for the full list. */
const featured = (await getCollection('projects', (p) => !p.data.draft && p.data.featured))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const PILLARS: CarouselItem[] = [
  {
    id: 'agents',
    index: '01',
    title: 'Agent systems',
    body: 'Multi-step agents that plan, call tools, and recover from their own failures — with the orchestration and evaluation scaffolding that makes them survive production.',
    tags: ['Tool use', 'Orchestration', 'Evals'],
  },
  {
    id: 'tooling',
    index: '02',
    title: 'Developer tooling',
    body: 'The layer underneath the product: CLIs, harnesses, and interfaces that shorten the loop between an idea and a measured result.',
    tags: ['CLI', 'DX', 'Automation'],
  },
  {
    id: 'nlp',
    index: '03',
    title: 'Applied NLP',
    body: 'Retrieval, extraction, and evaluation pipelines built to be inspected — where every answer traces back to the input that produced it.',
    tags: ['RAG', 'Extraction', 'Benchmarks'],
  },
];
---

<BaseLayout>
  {
    /*
    ── Hero ─────────────────────────────────────────────────────────
    Two columns at >=lg: statement left, instrument right. The art and the
    words must not stack — an earlier revision centred the corona behind the
    headline and the two fought each other for the same pixels.

    Below lg there is no room for a side-by-side, so the corona drops behind
    the text at low opacity and becomes texture rather than subject.
  */
  }
  <section class="relative flex min-h-[calc(100dvh-3.5rem)] items-center lg:min-h-dvh">
    <div
      class="shell relative grid w-full items-center gap-12 py-20 lg:grid-cols-[1fr_minmax(0,32rem)]"
    >
      <Reveal class="relative z-10 max-w-2xl">
        <p class="eyebrow eyebrow-marked">{'Agentic developer'}</p>

        <h1 class="display mt-6 text-6xl sm:text-7xl">Systems that act</h1>

        <p class="text-muted prose-measure mt-7 text-lg leading-relaxed">
          I build the layer where language models stop being a demo and start being infrastructure.
        </p>

        <a
          href={href('/projects')}
          class="group border-fg text-fg hover:bg-fg hover:text-ground mt-10 inline-flex h-12 items-center gap-3 border px-6 text-sm font-semibold transition-colors"
        >
          See the work
          <Icon name="arrow-right" size={16} />
        </a>
      </Reveal>

      {
        /*
        Instrument: corona inside the dial.

        Below lg this sits behind the text and must recede. That dimming is
        done with a CSS custom property consumed by the children, NOT with
        `opacity` on this wrapper — a wrapper opacity composites the whole
        subtree, which silently halved the particle contrast in both themes
        and was invisible until the rendered pixels were measured.
      */
      }
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 [--instrument:0.3] lg:relative lg:z-10 lg:[--instrument:1]"
      >
        <div class="relative mx-auto aspect-square w-[min(120vw,34rem)] lg:w-full lg:max-w-[32rem]">
          <ParticleField style="opacity: var(--instrument)" />
          <div class="text-fg absolute inset-0" style="opacity: calc(var(--instrument) * 0.4)">
            <HudRing ticks={72} spin={240} />
          </div>
        </div>
      </div>
    </div>

    <span
      aria-hidden="true"
      class="text-faint absolute inset-x-0 bottom-6 hidden justify-center font-mono text-[10px] tracking-[0.3em] uppercase lg:flex"
    >
      scroll
    </span>
  </section>

  {/* ── Capabilities ───────────────────────────────────────────────── */}
  <section class="shell border-line border-t py-24" aria-labelledby="capabilities">
    <Reveal>
      <p class="eyebrow eyebrow-marked">Capabilities</p>
      <h2 id="capabilities" class="sr-only">Capabilities</h2>
      <div class="mt-10">
        <Carousel client:visible items={PILLARS} label="Capabilities" />
      </div>
    </Reveal>
  </section>

  {/* ── Selected work ──────────────────────────────────────────────── */}
  {
    featured.length > 0 && (
      <section class="shell border-line border-t py-24" aria-labelledby="work">
        <Reveal>
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="eyebrow eyebrow-marked">Selected work</p>
              <h2 id="work" class="display mt-5 text-4xl sm:text-5xl">
                Things you can poke at
              </h2>
            </div>

            <a
              href={href('/projects')}
              class="text-muted hover:text-accent inline-flex items-center gap-2 font-mono text-xs transition-colors"
            >
              All projects
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        </Reveal>

        <ul class="mt-12 grid gap-5 md:grid-cols-2">
          {featured.map((project, i) => (
            <Reveal as="li" delay={i * 90}>
              <ProjectCard project={project} />
            </Reveal>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
