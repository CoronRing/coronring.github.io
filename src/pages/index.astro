---
/**
 * Home — the deck, then five quieter bands.
 *
 *   #top       The deck. Six frames, one live exhibit, edge to edge.
 *   #work      Selected work — media-led project cards
 *   #resume    Myself — three capabilities and the work behind each
 *   #tools     The dev kit, played one tool at a time
 *   #ask       The assistant, in the page rather than on a page of its own
 *   #resources Notes and references, last
 *
 * ## Why the hero and the work section are one thing now
 *
 * They were two full bands saying the same thing twice. The hero showed the
 * particle engine with no way to drive it; the work band showed the same
 * engine again, boxed inside a console, inside a section header, and then
 * repeated all three projects underneath as cards. A visitor met the corona,
 * scrolled, and met it again smaller.
 *
 * The deck collapses that into one surface: the exhibit fills the viewport and
 * the roster is a rail beside it, so the first screen is both the introduction
 * and the work, and moving between projects costs one click rather than a
 * scroll through three headers. See `components/deck/ProjectDeck.tsx`.
 *
 * The rail scroll-spies these ids (see `Sidebar.astro`). Dedicated pages still
 * exist for each and hold the full lists; this page is the tour.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleField from '../components/decor/ParticleField.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import ProjectDeck from '../components/deck/ProjectDeck';
import ProjectCard from '../components/ui/ProjectCard.astro';
import ChatPage from '../components/chat/ChatPage';
import Capabilities, { type Pillar } from '../components/resume/Capabilities';
import ToolShowcase, { type ShowcaseTool } from '../components/tools/ToolShowcase';
import Reveal from '../components/ui/Reveal.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../data/site';
import { TOOLS } from '../data/tools';
import { href } from '../lib/url';
import { monthYear } from '../lib/format';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Plain data for the deck island — content entries do not cross the boundary. */
const deckProjects = projects.map((p) => ({
  id: p.id,
  title: p.data.title,
  summary: p.data.summary,
  status: p.data.status,
  tech: p.data.tech,
  period: p.data.period,
  href: href(`/projects/${p.id}`),
}));

const resources = (await getCollection('resources', (r) => !r.data.draft))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  .slice(0, 4);

const liveTools = TOOLS.filter((t) => t.status === 'live');

/**
 * The three capabilities, and for each of them the work that is the evidence.
 *
 * `evidence` names an experience entry and which of its highlights belongs to
 * this capability, rather than restating either. The role, the organisation and
 * the dates come from the collection, so editing a resume entry still edits
 * this section, and the only thing decided here is what supports what.
 */
interface PillarSpec {
  id: string;
  index: string;
  title: string;
  body: string;
  tags: string[];
  evidence: Array<{ entry: string; highlight: number }>;
}

const PILLAR_SPECS: PillarSpec[] = [
  {
    id: 'agents',
    index: '01',
    title: 'Agent systems',
    body: 'Multi-step agents that plan, call tools, and recover from their own failures, with the orchestration it takes to keep them running in production.',
    tags: ['Tool use', 'Orchestration', 'Evals'],
    evidence: [
      { entry: '02-railtown-mle', highlight: 0 },
      { entry: '02-railtown-mle', highlight: 1 },
      { entry: '04-railtown-ds', highlight: 1 },
    ],
  },
  {
    id: 'evaluation',
    index: '02',
    title: 'Evaluation',
    body: 'If it cannot be measured, it should not ship. Benchmarks that score expert systems on accuracy, hallucination, security and fairness, and the harness that keeps the scores comparable.',
    tags: ['Benchmarks', 'Hallucination', 'Safety'],
    evidence: [
      { entry: '02-railtown-mle', highlight: 2 },
      { entry: '04-railtown-ds', highlight: 0 },
    ],
  },
  {
    id: 'systems',
    index: '03',
    title: 'Systems and hardware',
    body: 'GPU programming, HDL, and vision-language models that read hardware schematics. The half of the work that runs below the model rather than on top of it.',
    tags: ['VLM', 'CUDA', 'Verilog'],
    evidence: [
      { entry: '03-ubc-salt', highlight: 1 },
      { entry: '03-ubc-salt', highlight: 0 },
    ],
  },
];

const experience = await getCollection('experience');
const byId = new Map(experience.map((e) => [e.id, e]));

const PILLARS: Pillar[] = PILLAR_SPECS.map((spec) => ({
  id: spec.id,
  index: spec.index,
  title: spec.title,
  body: spec.body,
  tags: spec.tags,
  evidence: spec.evidence.flatMap((ref) => {
    const entry = byId.get(ref.entry);
    const note = entry?.data.highlights[ref.highlight];
    if (!entry || !note) return [];
    return [
      {
        role: entry.data.role,
        organization: entry.data.organization,
        period: `${monthYear(entry.data.start)} – ${
          entry.data.end ? monthYear(entry.data.end) : 'Present'
        }`,
        note,
      },
    ];
  }),
}));

/** Plain data for the tools island. */
const showcaseTools: ShowcaseTool[] = liveTools.map((t) => ({
  slug: t.slug,
  name: t.name,
  summary: t.summary,
  href: href(`/tools/${t.slug}`),
  offline: t.offline,
}));
---

<BaseLayout>
  {
    /* ══ 00 · The deck ═════════════════════════════════════════════
      `client:load`, not `client:visible`: this *is* the first screen, so
      deferring it would mean deferring the page. */
  }
  <ProjectDeck
    client:load
    projects={deckProjects}
    statement="Systems that act"
    name="Guan Huang"
    role={SITE.role}
    intro="I build agent systems, the evaluation tooling that keeps them honest, and the infrastructure both run on."
    links={SITE.social.map((s) => ({ label: s.label, href: s.href }))}
    indexHref={href('/projects')}
  />

  {
    /* ══ 01 · Selected work ════════════════════════════════════════
      Cards rather than a list of names. The cover art is generated from the
      project id, so an entry is a picture from the day it is added instead of
      a grey box waiting on a screenshot. */
  }
  <section
    id="work"
    aria-labelledby="work-h"
    class="border-line scroll-mt-16 border-t py-24 lg:py-32"
  >
    <div class="shell">
      <Reveal>
        <SectionHead
          index="01"
          eyebrow="Selected work"
          title="Read the blueprints"
          headingId="work-h"
          moreHref="/projects"
          moreLabel="All projects"
        />
      </Reveal>

      <ul class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          projects.map((project, i) => (
            <Reveal as="li" class="min-w-0" delay={(i % 3) * 80}>
              <ProjectCard project={project} />
            </Reveal>
          ))
        }
      </ul>
    </div>
  </section>

  {
    /* ══ 02 · Myself ═══════════════════════════════════════════════
      Three capabilities, and the work that is the evidence for each. The
      panel advances as the band scrolls past, so the section reads itself out
      to a visitor who only scrolls; the indicator scrubs it for one who
      would rather drive. See `components/resume/Capabilities.tsx`. */
  }
  <section
    id="resume"
    aria-labelledby="resume-h"
    class="border-line scroll-mt-16 border-t py-24 lg:pt-32 lg:pb-0"
  >
    <div class="shell">
      <Reveal>
        <SectionHead
          index="02"
          eyebrow="Experience"
          title="Myself"
          headingId="resume-h"
          moreHref="/resume"
          moreLabel="Full resume"
        />
      </Reveal>

      <div class="mt-14">
        <Capabilities client:visible pillars={PILLARS} label="Capabilities" />
      </div>
    </div>
  </section>

  {
    /* ══ 03 · Tools ════════════════════════════════════════════════
      One instrument rather than ten cards: a roster, and a screen that plays
      whichever tool is held. See `components/tools/ToolShowcase.tsx`. */
  }
  <section
    id="tools"
    aria-labelledby="tools-h"
    class="border-line scroll-mt-16 border-t py-24 lg:py-32"
  >
    <div class="shell">
      <Reveal>
        <SectionHead
          index="03"
          eyebrow="Tools"
          title="AI dev kit, on the web"
          headingId="tools-h"
          moreHref="/tools"
          moreLabel="All tools"
        />
      </Reveal>

      <div class="mt-12">
        <ToolShowcase client:visible tools={showcaseTools} indexHref={href('/tools')} />
      </div>
    </div>
  </section>

  {
    /* ══ Contact ═══════════════════════════════════════════════════
      Bookended with the same material the page opened on: the corona, this
      time decorative and behind the type rather than in front of it. */
  }
  <section
    aria-labelledby="contact-h"
    class="border-line relative scroll-mt-16 overflow-hidden border-t py-24 lg:py-32"
  >
    {
      /*
        Held to the right half so it sits beside the headline rather than
        under it. Decorative and non-interactive: the driveable copy is the
        deck at the top of the page, and a second live canvas competing for
        the cursor down here would be noise.
      */
    }
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-0 w-[min(48rem,52%)] opacity-20"
    >
      <ParticleField interactive={false} />
    </div>

    <div class="shell relative">
      <Reveal>
        <p class="eyebrow eyebrow-marked">Contact</p>
        <h2 id="contact-h" class="display mt-5 max-w-3xl text-4xl sm:text-5xl lg:text-6xl">
          Building something that has to think for itself?
        </h2>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href={SITE.cta.href}
            class="bg-accent-fill text-accent-on-fill inline-flex h-12 items-center gap-3 px-6 text-sm font-semibold transition-opacity hover:opacity-85"
          >
            {SITE.email}
            <Icon name="arrow-right" size={16} />
          </a>
          {
            SITE.social
              .filter((s) => !s.href.startsWith('mailto:'))
              .map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-line text-muted hover:border-fg hover:text-fg bg-ground/60 inline-flex h-12 items-center gap-2 border px-5 text-sm backdrop-blur-sm transition-colors"
                >
                  <Icon name={s.icon} size={15} />
                  {s.label}
                </a>
              ))
          }
        </div>
      </Reveal>
    </div>
  </section>
  {
    /* ══ 04 · Ask ══════════════════════════════════════════════════
      The assistant belongs in the page. It used to live only on `/chat`,
      which meant the one part of the site that answers questions was the one
      part you had to navigate away to reach. `client:visible`, so it costs
      nothing until it is scrolled to. */
  }
  <section
    id="ask"
    aria-labelledby="ask-h"
    class="border-line scroll-mt-16 border-t py-24 lg:py-32"
  >
    <div class="shell">
      <Reveal>
        <SectionHead
          index="04"
          eyebrow="Assistant"
          title="Ask about any of this"
          headingId="ask-h"
          moreHref="/chat"
          moreLabel="Full page"
        />
      </Reveal>

      <div class="mt-12">
        <ChatPage client:visible />
      </div>
    </div>
  </section>

  {/* ══ 05 · Resources ════════════════════════════════════════════ */}
  {
    resources.length > 0 && (
      <section
        id="resources"
        aria-labelledby="resources-h"
        class="border-line scroll-mt-16 border-t py-24 lg:py-32"
      >
        <div class="shell">
          <Reveal>
            <SectionHead
              index="05"
              eyebrow="Resources"
              title="Notes and references"
              headingId="resources-h"
              moreHref="/resources"
              moreLabel="All resources"
            />
          </Reveal>

          <ul class="divide-line mt-12 divide-y">
            {resources.map((entry, i) => (
              <Reveal as="li" delay={i * 50}>
                <a
                  href={entry.data.url ?? href('/resources')}
                  target={entry.data.url ? '_blank' : undefined}
                  rel={entry.data.url ? 'noopener noreferrer' : undefined}
                  class="group hover:text-accent flex items-baseline gap-5 py-5 transition-colors"
                >
                  <span class="text-faint font-mono text-[10px] uppercase">
                    {entry.data.category}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-base">{entry.data.title}</span>
                    <span class="text-muted mt-1 block text-sm leading-relaxed">
                      {entry.data.summary}
                    </span>
                  </span>
                  <Icon
                    name="arrow-up-right"
                    size={14}
                    class="text-faint group-hover:text-accent shrink-0 transition-colors"
                  />
                </a>
              </Reveal>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
