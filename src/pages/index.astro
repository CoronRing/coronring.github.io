---
/**
 * Home — the deck, then six quieter bands.
 *
 *   #top       The deck. Six frames, one live exhibit, edge to edge.
 *   #work      Selected work — media-led project cards
 *   #resume    Myself — three capabilities and the proof for each
 *   #tools     The dev kit, played one tool at a time
 *   #posts     Writing, the newest post featured with its cover
 *   #ask       The assistant, in the page rather than on a page of its own
 *   #resources Notes and references, last
 *
 * The deck is both the introduction and the work: the exhibit takes the first
 * screen and the roster is a rail beside it, so moving between projects costs
 * one click rather than a scroll through three headers. See
 * `components/deck/ProjectDeck.tsx`.
 *
 * The rail scroll-spies these ids (see `Sidebar.astro`). Dedicated pages still
 * exist for each and hold the full lists; this page is the tour.
 */
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleField from '../components/decor/ParticleField.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import ProjectDeck from '../components/deck/ProjectDeck';
import ProjectCard from '../components/ui/ProjectCard.astro';
import ChatPage from '../components/chat/ChatPage';
import Capabilities, { type Pillar, type ProofMark } from '../components/resume/Capabilities';
import ToolShowcase, { type ShowcaseTool } from '../components/tools/ToolShowcase';
import Reveal from '../components/ui/Reveal.astro';
import PostsBand from '../components/posts/PostsBand.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../data/site';
import { TOOLS } from '../data/tools';
import { href } from '../lib/url';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

/** Plain data for the deck island — content entries do not cross the boundary. */
const deckProjects = projects.map((p) => ({
  id: p.id,
  title: p.data.title,
  summary: p.data.summary,
  status: p.data.status,
  tech: p.data.tech,
  period: p.data.period,
  href: href(`/projects/${p.id}`),
}));

/** Posts, newest first, for their own band. */
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
);

/**
 * The notes band: resources, newest first. External links open in a new tab;
 * notes without a URL go to the Resources page.
 */
interface NoteRow {
  readonly key: string;
  readonly label: string;
  readonly title: string;
  readonly summary: string;
  readonly date: Date;
  readonly href: string;
  readonly external: boolean;
}

const notes: NoteRow[] = (await getCollection('resources', (r) => !r.data.draft))
  .map((r) => ({
    key: `resource-${r.id}`,
    label: r.data.category,
    title: r.data.title,
    summary: r.data.summary,
    date: r.data.updated,
    href: r.data.url ?? href('/resources'),
    external: Boolean(r.data.url),
  }))
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 4);

const liveTools = TOOLS.filter((t) => t.status === 'live');

/** Who and what this site is, for search engines: schema.org `WebSite` and `Person`. */
const siteData = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.name,
    jobTitle: SITE.role,
    url: SITE.url,
    sameAs: SITE.social.filter((s) => s.href.startsWith('https://')).map((s) => s.href),
  },
];

/**
 * The three capabilities, and for each of them the proof.
 *
 * This band is the glance, not the resume: each proof is a figure or a logo and
 * one line, condensed from what `/resume` carries in full. `entry` names the
 * experience entry a proof comes from, so the credit under it (role,
 * organisation, years) still comes from the collection; `credit: 'org'` drops
 * the role, which suits a degree whose claim already names it.
 */
type ProofSpec = {
  claim: string;
  entry?: string;
  credit?: 'role' | 'org';
} & ({ figure: string } | { logo: string; alt: string });

interface PillarSpec {
  id: string;
  index: string;
  title: string;
  /** One sentence. */
  body: string;
  tags: string[];
  proof: ProofSpec[];
}

const PILLAR_SPECS: PillarSpec[] = [
  {
    id: 'agents',
    index: '01',
    title: 'Agent systems',
    body: 'Agents that plan, call tools and recover from their own failures, built to stay up in production.',
    tags: ['Tool use', 'Orchestration', 'Evals'],
    proof: [
      { figure: '20', claim: 'Agents delivered to production', entry: '02-railtown-mle' },
      {
        figure: '1st',
        claim: 'Agentic framework in Canada: Railtracks, which I designed and built',
        entry: '02-railtown-mle',
      },
      { figure: '5+', claim: 'Years of experience shipping machine learning' },
    ],
  },
  {
    id: 'evaluation',
    index: '02',
    title: 'Evaluation',
    body: 'If it cannot be measured, it should not ship. Benchmarks, and the harness that keeps scores comparable.',
    tags: ['Benchmarks', 'Hallucination', 'Safety'],
    proof: [
      {
        figure: '100s',
        claim:
          'Deployed products scored by AEval for accuracy, hallucination, security and fairness',
        entry: '02-railtown-mle',
      },
      {
        figure: '91%',
        claim: 'User preference for a multi-model ensemble in A/B tests',
        entry: '04-railtown-ds',
      },
    ],
  },
  {
    id: 'background',
    index: '03',
    title: 'Background',
    body: 'A master’s in applied AI, on top of an engineering degree that started at the hardware.',
    tags: ['MScAC', 'Computer Engineering', 'Machine learning'],
    proof: [
      {
        logo: 'uoft.svg',
        alt: 'University of Toronto',
        claim:
          'MScAC, Master of Science in Applied Computing, Artificial Intelligence specialization',
        entry: '10-uoft-msc',
        credit: 'org',
      },
      {
        logo: 'ubc.svg',
        alt: 'University of British Columbia',
        claim: 'BASc Computer Engineering (CPEN), machine learning focus',
        entry: '11-ubc-basc',
        credit: 'org',
      },
      {
        figure: '1%',
        claim: 'Graduated in the top 1% of the Computer Engineering class',
        entry: '11-ubc-basc',
        credit: 'org',
      },
    ],
  },
];

const experience = await getCollection('experience');
const byId = new Map(experience.map((e) => [e.id, e]));

/**
 * The credit under a proof, from the collection:
 * `"Applied ML Engineer · Railtown AI · 2023–2025"`, or with `'org'`,
 * `"University of Toronto · 2025–2026"`.
 */
function credit(entryId: string, mode: 'role' | 'org'): string | undefined {
  const entry = byId.get(entryId);
  if (!entry) throw new Error(`Myself: no experience entry "${entryId}"`);
  const { role, organization, shortName, start, end } = entry.data;
  const from = start.getUTCFullYear();
  const to = end ? end.getUTCFullYear() : 'Present';
  const years = from === to ? String(from) : `${from}–${to}`;
  return mode === 'org'
    ? [organization, years].join(' · ')
    : [role, shortName ?? organization, years].join(' · ');
}

/**
 * A logo under `public/media/logos/`, with its aspect ratio read from the
 * file's own `viewBox` so a replaced logo never needs a matching code change.
 */
function logo(file: string, alt: string): ProofMark {
  const svg = readFileSync(join(process.cwd(), 'public', 'media', 'logos', file), 'utf8');
  const box = /viewBox="([^"]+)"/
    .exec(svg)?.[1]
    ?.trim()
    .split(/[\s,]+/)
    .map(Number);
  const [, , w, h] = box ?? [];
  if (!w || !h) throw new Error(`Myself: ${file} has no usable viewBox`);
  return { kind: 'logo', src: href(`/media/logos/${file}`), alt, ratio: w / h };
}

const PILLARS: Pillar[] = PILLAR_SPECS.map((spec) => ({
  id: spec.id,
  index: spec.index,
  title: spec.title,
  body: spec.body,
  tags: spec.tags,
  proof: spec.proof.map((p) => ({
    mark: 'figure' in p ? { kind: 'figure', text: p.figure } : logo(p.logo, p.alt),
    claim: p.claim,
    source: p.entry ? credit(p.entry, p.credit ?? 'role') : undefined,
  })),
}));

/** Plain data for the tools island. */
const showcaseTools: ShowcaseTool[] = liveTools.map((t) => ({
  slug: t.slug,
  name: t.name,
  summary: t.summary,
  href: href(`/tools/${t.slug}`),
  offline: t.offline,
}));
---

<BaseLayout holdVeil structuredData={siteData}>
  {
    /* ══ 00 · The deck ═════════════════════════════════════════════
      `client:load`, not `client:visible`: this *is* the first screen, so
      deferring it would mean deferring the page. */
  }
  <ProjectDeck
    client:load
    projects={deckProjects}
    statement="Systems that act"
    name="Guan Huang"
    role={SITE.role}
    intro="I build agent systems, the evaluation tooling that keeps them honest, and the infrastructure both run on."
    links={SITE.social.map((s) => ({ label: s.label, href: s.href, icon: s.icon }))}
    indexHref={href('/projects')}
  />

  {
    /* ══ 01 · Selected work ════════════════════════════════════════
      Cards rather than a list of names. The cover art is generated from the
      project id, so an entry is a picture from the day it is added instead of
      a grey box waiting on a screenshot. */
  }
  <section id="work" aria-labelledby="work-h" class="border-line border-t py-24 lg:py-32">
    <div class="shell">
      <Reveal>
        <SectionHead
          index="01"
          eyebrow="Selected work"
          title="Read the blueprints"
          headingId="work-h"
          moreHref="/projects"
          moreLabel="All projects"
        />
      </Reveal>

      <ul class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          projects.map((project, i) => (
            <Reveal as="li" class="min-w-0" delay={(i % 3) * 80}>
              <ProjectCard project={project} />
            </Reveal>
          ))
        }
      </ul>
    </div>
  </section>

  {
    /* ══ 02 · Myself ═══════════════════════════════════════════════
      Three capabilities, and the proof for each. The selection advances as
      the band scrolls past, so the section reads itself out to a visitor who
      only scrolls; the names are controls for one who would rather drive.
      The heading sits inside the pinned screen so the whole band is centred
      as one composition. See `components/resume/Capabilities.tsx`. */
  }
  <section
    id="resume"
    aria-labelledby="resume-h"
    class="border-line cap-band border-t py-24 lg:py-0"
  >
    <div class="cap-pin">
      <div class="shell">
        <Reveal>
          <SectionHead
            index="02"
            eyebrow="Experience"
            title="Myself"
            headingId="resume-h"
            moreHref="/resume"
            moreLabel="Full resume"
          />
        </Reveal>

        <div class="mt-12">
          <Capabilities client:visible pillars={PILLARS} label="Capabilities" />
        </div>
      </div>
    </div>
  </section>

  {
    /* ══ 03 · Tools ════════════════════════════════════════════════
      One instrument rather than ten cards: a roster, and a screen that plays
      whichever tool is held. The heading sits inside the pinned screen, as in
      Myself, so heading and kit are one composition and the kit can take the
      height that would otherwise be empty above it.
      See `components/tools/ToolShowcase.tsx`. */
  }
  <section
    id="tools"
    aria-labelledby="tools-h"
    class="border-line tools-band border-t py-24 lg:py-0"
  >
    <div class="tools-pin">
      <div class="shell">
        <Reveal>
          <SectionHead
            index="03"
            eyebrow="Tools"
            title="AI dev kit, on the web"
            headingId="tools-h"
            moreHref="/tools"
            moreLabel="All tools"
          />
        </Reveal>

        <div class="mt-10">
          <ToolShowcase client:visible tools={showcaseTools} indexHref={href('/tools')} />
        </div>
      </div>
    </div>
  </section>

  {
    /* ══ 04 · Posts ════════════════════════════════════════════════
      Writing as a band of its own, not rows in the notes list. See
      `components/posts/PostsBand.astro`. */
  }
  {
    posts.length > 0 && (
      <section id="posts" aria-labelledby="posts-h" class="border-line border-t py-24 lg:py-32">
        <div class="shell">
          <PostsBand posts={posts} index="04" headingId="posts-h" />
        </div>
      </section>
    )
  }

  {
    /* ══ Contact ═══════════════════════════════════════════════════
      Bookended with the same material the page opened on: the corona, this
      time decorative and behind the type rather than in front of it. */
  }
  <section
    aria-labelledby="contact-h"
    class="border-line relative overflow-hidden border-t py-24 lg:py-32"
  >
    {
      /*
        Held to the right half so it sits beside the headline rather than
        under it. Decorative and non-interactive: the driveable copy is the
        deck at the top of the page, and a second live canvas competing for
        the cursor down here would be noise.
      */
    }
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-y-0 right-0 w-[min(48rem,52%)] opacity-20"
    >
      <ParticleField interactive={false} />
    </div>

    <div class="shell relative">
      <Reveal>
        <p class="eyebrow eyebrow-marked">Contact</p>
        <h2 id="contact-h" class="display mt-5 max-w-3xl text-4xl sm:text-5xl lg:text-6xl">
          Building something that has to think for itself?
        </h2>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href={SITE.cta.href}
            class="bg-accent-fill text-accent-on-fill inline-flex h-12 items-center gap-3 px-6 text-sm font-semibold transition-opacity hover:opacity-85"
          >
            {SITE.email}
            <Icon name="arrow-right" size={16} />
          </a>
          {
            SITE.social
              .filter((s) => !s.href.startsWith('mailto:'))
              .map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-line text-muted hover:border-fg hover:text-fg bg-ground/60 inline-flex h-12 items-center gap-2 border px-5 text-sm backdrop-blur-sm transition-colors"
                >
                  <Icon name={s.icon} size={15} />
                  {s.label}
                </a>
              ))
          }
        </div>
      </Reveal>
    </div>
  </section>
  {
    /* ══ 05 · Ask ══════════════════════════════════════════════════
      The assistant belongs in the page: the one part of the site that
      answers questions should not be the one part you have to navigate away
      to reach. `client:visible`, so it costs nothing until it is scrolled
      to. `/chat` still exists for a full-page conversation. */
  }
  <section id="ask" aria-labelledby="ask-h" class="border-line border-t py-24 lg:py-32">
    <div class="shell">
      <Reveal>
        <SectionHead
          index="05"
          eyebrow="Assistant"
          title="Ask about any of this"
          headingId="ask-h"
          moreHref="/chat"
          moreLabel="Full page"
        />
      </Reveal>

      <div class="mt-12">
        <ChatPage client:visible />
      </div>
    </div>
  </section>

  {/* ══ 06 · Resources ════════════════════════════════════════════ */}
  {
    notes.length > 0 && (
      <section
        id="resources"
        aria-labelledby="resources-h"
        class="border-line border-t py-24 lg:py-32"
      >
        <div class="shell">
          <Reveal>
            <SectionHead
              index="06"
              eyebrow="Resources"
              title="Notes and references"
              headingId="resources-h"
              moreHref="/resources"
              moreLabel="All resources"
            />
          </Reveal>

          <ul class="divide-line mt-12 divide-y">
            {notes.map((entry, i) => (
              <Reveal as="li" delay={i * 50}>
                <a
                  href={entry.href}
                  target={entry.external ? '_blank' : undefined}
                  rel={entry.external ? 'noopener noreferrer' : undefined}
                  class="group hover:text-accent flex items-baseline gap-5 py-5 transition-colors"
                >
                  <span class="text-faint w-16 shrink-0 font-mono text-[10px] uppercase">
                    {entry.label}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-base">{entry.title}</span>
                    <span class="text-muted mt-1 block text-sm leading-relaxed">
                      {entry.summary}
                    </span>
                  </span>
                  <Icon
                    name={entry.external ? 'arrow-up-right' : 'arrow-right'}
                    size={18}
                    class="text-muted group-hover:text-accent shrink-0 self-center transition-[color,transform] duration-[var(--dur-base)] group-hover:translate-x-1"
                  />
                </a>
              </Reveal>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
