---
/**
 * Home — a single continuous scroll flow.
 *
 * The reference is one page read top to bottom, with media taking most of the
 * space and text kept to what fits in a glance. This mirrors that: five full
 * bands, each with one idea, one visual, and a way deeper.
 *
 *   #top       Hero — the interactive corona, one statement, one action
 *   #work      Selected work — media-led project cards
 *   #resume    Experience — condensed timeline
 *   #resources Notes and references
 *   #tools     Browser-local utilities
 *
 * The rail scroll-spies these ids (see `Sidebar.astro`). Dedicated pages
 * still exist for each and hold the full lists; this page is the tour.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ParticleField from '../components/decor/ParticleField.astro';
import HudRing from '../components/decor/HudRing.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import OperatorShowcase from '../components/demos/OperatorShowcase';
import Carousel, { type CarouselItem } from '../components/ui/Carousel';
import Reveal from '../components/ui/Reveal.astro';
import Icon from '../components/ui/Icon.astro';
import ScrollCue from '../components/ui/ScrollCue.astro';
import { SITE } from '../data/site';
import { TOOLS } from '../data/tools';
import { href } from '../lib/url';
import { monthYear } from '../lib/format';

const featured = (await getCollection('projects', (p) => !p.data.draft && p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);

const featuredSummaries = featured.map((p) => ({
  id: p.id,
  title: p.data.title,
  summary: p.data.summary,
  status: p.data.status,
  tech: p.data.tech,
  period: p.data.period,
  href: href(`/projects/${p.id}`),
}));

/** Most recent roles only — the resume page carries everything. */
const work = (await getCollection('experience', (e) => e.data.kind === 'work'))
  .sort((a, b) => {
    const ae = a.data.end?.getTime() ?? Number.POSITIVE_INFINITY;
    const be = b.data.end?.getTime() ?? Number.POSITIVE_INFINITY;
    return be - ae || b.data.start.getTime() - a.data.start.getTime();
  })
  .slice(0, 3);

const resources = (await getCollection('resources', (r) => !r.data.draft))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  .slice(0, 4);

const liveTools = TOOLS.filter((t) => t.status === 'live');

const PILLARS: CarouselItem[] = [
  {
    id: 'agents',
    index: '01',
    title: 'Agent systems',
    body: 'Multi-step agents that plan, call tools, and recover from their own failures, with the orchestration and evaluation scaffolding it takes to keep them running in production. Shipped a DevOps agent that users preferred to GitHub Copilot 90% of the time.',
    tags: ['Tool use', 'Orchestration', 'Evals'],
  },
  {
    id: 'evaluation',
    index: '02',
    title: 'Evaluation',
    body: 'If it cannot be measured, it should not ship. I built AEval, which scores AI expert systems on accuracy, hallucination, security and fairness. It now runs inside hundreds of deployed products.',
    tags: ['Benchmarks', 'Hallucination', 'Safety'],
  },
  {
    id: 'systems',
    index: '03',
    title: 'Systems and hardware',
    body: 'From GPU programming and HDL to vision-language models that read hardware schematics. Research on control-flow guided test generation lifted branch coverage from 88% to 93%.',
    tags: ['VLM', 'CUDA', 'Verilog'],
  },
];
---

<BaseLayout>
  {/* ══ 00 · Hero ═════════════════════════════════════════════════ */}
  <section
    id="top"
    aria-label="Introduction"
    class="relative flex min-h-[calc(100dvh-3.5rem)] scroll-mt-0 items-center lg:min-h-dvh"
  >
    <div
      class="shell relative grid w-full items-center gap-12 py-20 lg:grid-cols-[1fr_minmax(0,34rem)]"
    >
      {
        /*
        Staggered cascade rather than one block fade: the eyebrow sets the
        frame, the headline is *set* by a wipe, then the supporting copy and
        actions arrive. Reading order and animation order agree, which is what
        makes a sequence feel composed rather than merely decorated.
      */
      }
      <div class="relative z-10 max-w-2xl">
        <Reveal>
          <p class="eyebrow eyebrow-marked">{SITE.role} · {SITE.location}</p>
        </Reveal>

        <Reveal variant="wipe" delay={140}>
          <h1 class="display mt-6 text-6xl sm:text-7xl">Systems that act</h1>
        </Reveal>

        <Reveal delay={340}>
          <p class="text-muted prose-measure mt-7 text-lg leading-relaxed">
            I build agent systems that hold up outside a demo, plus the evaluation and tooling it
            takes to get them there.
          </p>
        </Reveal>

        <Reveal delay={460} class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="#work"
            class="group border-fg text-fg hover:bg-fg hover:text-ground inline-flex h-12 items-center gap-3 border px-6 text-sm font-semibold transition-colors"
          >
            See the work
            <Icon
              name="arrow-right"
              size={16}
              class="transition-transform duration-[var(--dur-base)] group-hover:translate-x-1"
            />
          </a>
          <a
            href={href('/resume')}
            class="text-muted hover:text-accent inline-flex h-12 items-center gap-2 px-2 font-mono text-xs transition-colors"
          >
            Resume
          </a>
        </Reveal>
      </div>

      {
        /*
        The instrument. Interactive: the canvas takes pointer events so the
        cloud repels from the cursor and clicks send waves. It sits in its own
        grid column at lg so it never overlaps the text.
      */
      }
      <div class="relative">
        <div class="relative mx-auto aspect-square w-[min(120vw,34rem)] lg:w-full">
          <ParticleField interactive />
          <div class="text-fg pointer-events-none absolute inset-0 opacity-40">
            <HudRing ticks={72} spin={140} />
          </div>
        </div>

        <p
          class="text-faint mt-4 text-center font-mono text-[10px] tracking-[0.2em] uppercase lg:text-right"
        >
          move the cursor · click to send a wave
        </p>
      </div>
    </div>

    <ScrollCue href="#work" class="absolute inset-x-0 bottom-8 mx-auto hidden w-fit lg:flex" />
  </section>

  {/* ══ 01 · Work ═════════════════════════════════════════════════ */}
  <section
    id="work"
    aria-labelledby="work-h"
    class="border-line scroll-mt-16 border-t py-24 lg:py-32"
  >
    <div class="shell">
      <Reveal>
        <SectionHead
          index="01"
          eyebrow="Selected work"
          title="Things you can look at"
          headingId="work-h"
          lede="Working interactive engines, multi-agent pipelines, and developer tooling. 80% visual, live, and driveable."
          moreHref="/projects"
          moreLabel="All projects"
        />
      </Reveal>

      <div class="mt-10">
        <Reveal>
          <OperatorShowcase client:visible projects={featuredSummaries} />
        </Reveal>
      </div>

      <div class="mt-14">
        <div class="mb-6 flex items-center justify-between border-b border-line pb-3">
          <span class="eyebrow">All Project Blueprints</span>
          <span class="font-mono text-xs text-faint">{featured.length} live systems</span>
        </div>

        <ul class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
          {
            featured.map((project, i) => (
              <Reveal as="li" delay={(i % 3) * 90}>
                <ProjectCard project={project} />
              </Reveal>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ══ 02 · Capability + experience ══════════════════════════════ */}
  <section
    id="resume"
    aria-labelledby="resume-h"
    class="border-line scroll-mt-16 border-t py-24 lg:py-32"
  >
    <div class="shell">
      <Reveal>
        <SectionHead
          index="02"
          eyebrow="Experience"
          title="What I actually do"
          headingId="resume-h"
          moreHref="/resume"
          moreLabel="Full resume"
        />
      </Reveal>

      <div class="mt-14 grid gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-20">
        <Reveal>
          <Carousel client:visible items={PILLARS} label="Capabilities" />
        </Reveal>

        <Reveal delay={120}>
          <p class="eyebrow">Recent roles</p>
          <ul class="divide-line mt-5 divide-y">
            {
              work.map((entry) => (
                <li class="py-4">
                  <p class="text-faint tabular font-mono text-[11px]">
                    {monthYear(entry.data.start)} –{' '}
                    {entry.data.end ? monthYear(entry.data.end) : 'Present'}
                  </p>
                  <p class="mt-1.5 text-sm">{entry.data.role}</p>
                  <p class="text-accent text-sm">{entry.data.organization}</p>
                </li>
              ))
            }
          </ul>
        </Reveal>
      </div>
    </div>
  </section>

  {/* ══ 03 · Resources ════════════════════════════════════════════ */}
  {
    resources.length > 0 && (
      <section
        id="resources"
        aria-labelledby="resources-h"
        class="border-line scroll-mt-16 border-t py-24 lg:py-32"
      >
        <div class="shell">
          <Reveal>
            <SectionHead
              index="03"
              eyebrow="Resources"
              title="Notes and references"
              headingId="resources-h"
              lede="Things I keep coming back to, plus notes I wrote because the reference I wanted did not exist."
              moreHref="/resources"
              moreLabel="All resources"
            />
          </Reveal>

          <ul class="divide-line mt-12 divide-y">
            {resources.map((entry, i) => (
              <Reveal as="li" delay={i * 50}>
                <a
                  href={entry.data.url ?? href('/resources')}
                  target={entry.data.url ? '_blank' : undefined}
                  rel={entry.data.url ? 'noopener noreferrer' : undefined}
                  class="group hover:text-accent flex items-baseline gap-5 py-5 transition-colors"
                >
                  <span class="text-faint font-mono text-[10px] uppercase">
                    {entry.data.category}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-base">{entry.data.title}</span>
                    <span class="text-muted mt-1 block text-sm leading-relaxed">
                      {entry.data.summary}
                    </span>
                  </span>
                  <Icon
                    name="arrow-up-right"
                    size={14}
                    class="text-faint group-hover:text-accent shrink-0 transition-colors"
                  />
                </a>
              </Reveal>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* ══ 04 · Tools ════════════════════════════════════════════════ */}
  <section
    id="tools"
    aria-labelledby="tools-h"
    class="border-line scroll-mt-16 border-t py-24 lg:py-32"
  >
    <div class="shell">
      <Reveal>
        <SectionHead
          index="04"
          eyebrow="Tools"
          title="Runs in your browser"
          headingId="tools-h"
          lede="Nine instruments for language-model work. The work happens in the tab, and the few tools that have to reach the network say on their own page exactly what they touch."
          moreHref="/tools"
          moreLabel="All tools"
        />
      </Reveal>

      <ul class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {
          liveTools.map((tool, i) => (
            <Reveal as="li" delay={i * 80}>
              <a
                href={href(`/tools/${tool.slug}`)}
                class="group border-line bg-surface hover:border-fg flex h-full flex-col border p-6 transition-colors"
              >
                <div class="flex items-start justify-between gap-3">
                  <h3 class="group-hover:text-accent font-mono text-lg transition-colors">
                    {tool.name}
                  </h3>
                  <Icon
                    name="arrow-up-right"
                    size={15}
                    class="text-faint group-hover:text-accent mt-1 transition-colors"
                  />
                </div>
                <p class="text-muted mt-3 flex-1 text-sm leading-relaxed">{tool.summary}</p>
                <span class="bg-accent-fill mt-6 h-[3px] w-10 transition-[width] duration-[var(--dur-base)] group-hover:w-20" />
              </a>
            </Reveal>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ══ Contact ═══════════════════════════════════════════════════ */}
  <section aria-labelledby="contact-h" class="border-line scroll-mt-16 border-t py-24 lg:py-32">
    <div class="shell">
      <Reveal>
        <p class="eyebrow eyebrow-marked">Contact</p>
        <h2 id="contact-h" class="display mt-5 max-w-3xl text-4xl sm:text-5xl lg:text-6xl">
          Building something that has to think for itself?
        </h2>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href={SITE.cta.href}
            class="bg-accent-fill text-accent-on-fill inline-flex h-12 items-center gap-3 px-6 text-sm font-semibold transition-opacity hover:opacity-85"
          >
            {SITE.email}
            <Icon name="arrow-right" size={16} />
          </a>
          {
            SITE.social
              .filter((s) => !s.href.startsWith('mailto:'))
              .map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-line text-muted hover:border-fg hover:text-fg inline-flex h-12 items-center gap-2 border px-5 text-sm transition-colors"
                >
                  <Icon name={s.icon} size={15} />
                  {s.label}
                </a>
              ))
          }
        </div>
      </Reveal>
    </div>
  </section>
</BaseLayout>
