---
/**
 * Projects index — the demo gallery & operator deck.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import OperatorShowcase from '../../components/demos/OperatorShowcase';
import Reveal from '../../components/ui/Reveal.astro';
import { href } from '../../lib/url';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const projectSummaries = projects.map((p) => ({
  id: p.id,
  title: p.data.title,
  summary: p.data.summary,
  status: p.data.status,
  tech: p.data.tech,
  period: p.data.period,
  href: href(`/projects/${p.id}`),
}));
---

<PageLayout
  eyebrow="Interactive Showcase"
  title="Things you can look at"
  description="Operator-grade interactive demos of agent systems, physics renderers, and prompt tooling."
  lede="Working interactive engines, multi-agent pipelines, and developer tooling. 80% visual, live, and driveable."
>
  {
    projects.length > 0 ? (
      <div class="space-y-14">
        <Reveal>
          <OperatorShowcase client:load projects={projectSummaries} />
        </Reveal>

        <div>
          <div class="mb-6 flex items-center justify-between border-b border-line pb-3">
            <span class="eyebrow">Project Blueprints & Architecture</span>
            <span class="font-mono text-xs text-faint">{projects.length} systems online</span>
          </div>

          <ul class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {projects.map((project, i) => (
              <Reveal as="li" delay={(i % 3) * 80}>
                <ProjectCard project={project} />
              </Reveal>
            ))}
          </ul>
        </div>
      </div>
    ) : (
      <p class="text-muted text-sm">
        No projects published yet. Add an MDX file under{' '}
        <code class="text-accent font-mono">src/content/projects/</code>.
      </p>
    )
  }
</PageLayout>
