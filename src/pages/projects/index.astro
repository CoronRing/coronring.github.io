---
/**
 * Projects index — the demo gallery.
 *
 * A plain grid of ProjectCards. No status filters, no group headings, no
 * per-card tag clouds: with a handful of projects those are chrome around
 * content that already fits on one screen. Cards carry their own status dot.
 */
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import Reveal from '../../components/ui/Reveal.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<PageLayout
  eyebrow="Projects"
  title="Projects"
  description="Interactive demos of agent systems, developer tooling, and applied NLP work."
  lede="Working demos, not screenshots. Each page embeds the thing itself."
>
  {
    projects.length > 0 ? (
      <ul class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {projects.map((project, i) => (
          <Reveal as="li" delay={(i % 3) * 80}>
            <ProjectCard project={project} />
          </Reveal>
        ))}
      </ul>
    ) : (
      <p class="text-muted text-sm">
        No projects published yet. Add an MDX file under{' '}
        <code class="text-accent font-mono">src/content/projects/</code>.
      </p>
    )
  }
</PageLayout>
