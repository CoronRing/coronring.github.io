---
/**
 * Project detail page.
 *
 * The demo leads. Where `interactive` is set, the hydrated island sits
 * directly under the title, above the prose — the artifact is the argument
 * and the write-up supports it, not the other way round.
 *
 * Metadata sits in a sticky rail at >=lg, so the prose keeps its reading
 * measure instead of stretching to fill the page.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoFrame from '../../components/demos/DemoFrame.astro';
import PyRunner from '../../components/tools/PyRunner';
import { findPreset, presetsFor } from '../../data/py-presets';
import MediaFrame from '../../components/ui/MediaFrame.astro';
import Icon from '../../components/ui/Icon.astro';
import { href } from '../../lib/url';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { data } = project;

/**
 * Optional runnable console for this project's package.
 *
 * Resolved here so an unknown id fails the build with a message that names the
 * registry, rather than rendering an empty environment picker.
 */
const pyPreset = data.pyPreset ? findPreset(data.pyPreset) : undefined;
if (data.pyPreset && !pyPreset) {
  throw new Error(
    `Unknown pyPreset "${data.pyPreset}" for project "${data.title}". ` +
      `Add it to PY_PRESETS in src/data/py-presets.ts.`,
  );
}
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="shell pt-12 pb-10 sm:pt-16">
    <a
      href={href('/projects')}
      class="text-muted hover:text-accent inline-flex items-center gap-2 font-mono text-xs transition-colors"
    >
      <Icon name="arrow-left" size={13} />
      All projects
    </a>

    <h1 class="display mt-6 max-w-4xl text-5xl sm:text-6xl lg:text-7xl">{data.title}</h1>
    <p class="text-muted prose-measure mt-6 text-lg leading-relaxed">{data.summary}</p>
  </div>

  {
    data.hero && (
      <div class="shell pb-12">
        <MediaFrame
          src={data.hero.src}
          poster={data.hero.poster}
          alt={data.hero.alt || data.title}
          ratio={data.hero.ratio}
          label={data.hero.label}
          seed={project.id}
          expects={`/media/projects/${project.id}/hero.webp`}
          priority
        />
        {data.hero.caption && (
          <p class="text-faint mt-3 font-mono text-[11px]">{data.hero.caption}</p>
        )}
      </div>
    )
  }

  {
    data.interactive && data.demo && (
      <div class="shell pb-14">
        <DemoFrame demo={data.demo} title={data.title} />
      </div>
    )
  }

  <div class="shell grid gap-12 pb-24 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
    <article
      class="[&_a]:text-accent [&_code]:bg-sunken [&_h2]:display [&_pre]:border-line max-w-[var(--prose-max)] text-[15px] leading-[1.75] [&_a]:underline [&_a]:underline-offset-4 [&_code]:rounded-sm [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[0.85em] [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:text-2xl [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-lg [&_li]:my-1.5 [&_ol]:my-5 [&_ol]:list-decimal [&_ol]:pl-5 [&_p]:my-5 [&_pre]:my-6 [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:p-4 [&_ul]:my-5 [&_ul]:list-disc [&_ul]:pl-5"
    >
      <Content />
    </article>

    <aside class="lg:sticky lg:top-10 lg:self-start">
      <dl class="divide-line border-line divide-y border-t">
        {
          data.role && (
            <div class="py-4">
              <dt class="eyebrow">Role</dt>
              <dd class="mt-2 text-sm">{data.role}</dd>
            </div>
          )
        }
        {
          data.period && (
            <div class="py-4">
              <dt class="eyebrow">Period</dt>
              <dd class="mt-2 font-mono text-sm">{data.period}</dd>
            </div>
          )
        }
        {
          data.tech.length > 0 && (
            <div class="py-4">
              <dt class="eyebrow">Stack</dt>
              <dd class="text-muted mt-2 font-mono text-xs leading-relaxed">
                {data.tech.join(' · ')}
              </dd>
            </div>
          )
        }
      </dl>

      {
        data.links.length > 0 && (
          <ul class="mt-5 space-y-2">
            {data.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-line hover:border-fg flex h-10 items-center justify-between border px-3 text-sm transition-colors"
                >
                  {link.label}
                  <Icon name="arrow-up-right" size={13} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </aside>
  </div>

  {
    pyPreset && (
      <div class="shell border-line border-t py-16">
        <p class="eyebrow eyebrow-marked">Run it here</p>
        <p class="text-muted prose-measure mt-4 text-[15px] leading-relaxed">
          The published package, installed from PyPI into this tab and executed by a real CPython
          build. Nothing runs on a server, and the first run downloads the interpreter.
        </p>
        <div class="mt-8">
          {/* `client:visible` because this sits well below the fold and the
              interpreter is a 12 MB download that should not begin on page load. */}
          <PyRunner
            client:visible
            presets={presetsFor([pyPreset.id, 'plain'])}
            initial={pyPreset.id}
            rows={14}
          />
        </div>
      </div>
    )
  }

  {
    data.gallery.length > 0 && (
      <div class="shell border-line border-t py-16">
        <p class="eyebrow eyebrow-marked">Gallery</p>
        <ul class="mt-8 grid gap-6 md:grid-cols-2">
          {data.gallery.map((m, i) => (
            <li>
              <MediaFrame
                src={m.src}
                poster={m.poster}
                alt={m.alt}
                ratio={m.ratio}
                label={m.label}
                seed={`${project.id}-${i}`}
                expects={`/media/projects/${project.id}/${String(i + 1).padStart(2, '0')}.webp`}
              />
              {m.caption && <p class="text-faint mt-3 font-mono text-[11px]">{m.caption}</p>}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</BaseLayout>
