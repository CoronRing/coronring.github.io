---
/**
 * Resources — a curated, categorised index of references and notes.
 *
 * A hairline list, not a card grid. These are links: the useful information
 * is the title and one line of why, and a bordered box around each one adds
 * nothing but height.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Icon from '../components/ui/Icon.astro';
import Reveal from '../components/ui/Reveal.astro';
import { longDate } from '../lib/format';

type Resource = CollectionEntry<'resources'>;

const CATEGORY_LABEL = {
  agents: 'Agents',
  'llm-ops': 'LLM Ops',
  engineering: 'Engineering',
  reading: 'Reading',
  tooling: 'Tooling',
} as const;

const resources = await getCollection('resources', (r) => !r.data.draft);

/** Group by category, preserving the declaration order of CATEGORY_LABEL. */
const grouped = (Object.keys(CATEGORY_LABEL) as Array<Resource['data']['category']>)
  .map((category) => ({
    category,
    label: CATEGORY_LABEL[category],
    entries: resources
      .filter((r) => r.data.category === category)
      .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime()),
  }))
  .filter((group) => group.entries.length > 0);
---

<PageLayout
  eyebrow="Resources"
  title="Resources"
  description="References, notes, and reading on agents, LLM operations, and engineering practice."
  lede="A working bibliography — things I return to, plus notes I wrote because the reference I wanted didn't exist."
>
  {
    grouped.length > 0 ? (
      <div class="space-y-14">
        {grouped.map((group) => (
          <section aria-labelledby={`c-${group.category}`}>
            <h2 id={`c-${group.category}`} class="eyebrow eyebrow-marked">
              {group.label}
            </h2>

            <ul class="divide-line mt-5 divide-y">
              {group.entries.map((entry, i) => {
                const external = Boolean(entry.data.url);
                const Tag = external ? 'a' : 'div';
                return (
                  <Reveal as="li" delay={i * 40}>
                    <Tag
                      href={entry.data.url}
                      target={external ? '_blank' : undefined}
                      rel={external ? 'noopener noreferrer' : undefined}
                      class:list={[
                        'group flex items-baseline gap-4 py-5',
                        external && 'hover:text-accent transition-colors',
                      ]}
                    >
                      <div class="min-w-0 flex-1">
                        <h3 class="text-base leading-snug">
                          {entry.data.title}
                          {external && (
                            <Icon
                              name="arrow-up-right"
                              size={13}
                              class="text-faint group-hover:text-accent ml-1.5 inline align-baseline transition-colors"
                            />
                          )}
                        </h3>
                        <p class="text-muted mt-1.5 text-sm leading-relaxed">
                          {entry.data.summary}
                        </p>
                      </div>

                      <time
                        datetime={entry.data.updated.toISOString()}
                        class="text-faint hidden shrink-0 font-mono text-[10px] sm:block"
                      >
                        {longDate(entry.data.updated)}
                      </time>
                    </Tag>
                  </Reveal>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <p class="text-muted text-sm">
        No resources yet. Add Markdown files under{' '}
        <code class="text-accent font-mono">src/content/resources/</code>.
      </p>
    )
  }
</PageLayout>
