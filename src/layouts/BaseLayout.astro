---
/**
 * BaseLayout — the document shell. Every route renders through this.
 *
 * Owns: <head> metadata, font loading, the pre-paint theme script, the
 * contrast veil, the fixed backdrop, the navigation rail, the `<main>`
 * landmark, the footer, and the load-time fragment landing. Pages supply only
 * content and metadata.
 *
 * Layout model: the rail is `position: fixed`, and everything else is pushed
 * right by `.rail-offset` (a padding equal to `--rail-w` at >=lg, zero below).
 * Keeping the offset in CSS rather than a flex wrapper means page markup is
 * completely independent of the shell.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';

import { SITE } from '../data/site';
import { absolute } from '../lib/url';
import Veil from '../components/layout/Veil.astro';
import Backdrop from '../components/decor/Backdrop.astro';
import Sidebar from '../components/layout/Sidebar.astro';
import HashLanding from '../components/layout/HashLanding.astro';
import Footer from '../components/layout/Footer.astro';
import ChatDock from '../components/chat/ChatDock';

interface Props {
  title?: string;
  description?: string;
  /** Path to a social preview image under `public/`. */
  image?: string;
  /** Adds `noindex` — for drafts and utility routes. */
  noindex?: boolean;
  /**
   * Hide the corner assistant. Set by `/chat`, which *is* the assistant — a
   * floating copy of it over its own page is clutter, not a second door in.
   */
  hideChatDock?: boolean;
  /**
   * Keep the loading veil up until this page's exhibit reports in, rather than
   * lifting it on `load`. For a page that mounts something heavy above the
   * fold; see `components/layout/Veil.astro`.
   */
  holdVeil?: boolean;
  /**
   * Marks the page as an article for link previews: `og:type` becomes
   * `article` and the dates and tags are emitted. Set by blog posts only.
   */
  article?: { published: Date; updated?: Date; tags?: readonly string[] };
  /**
   * schema.org JSON-LD for search engines (a `BlogPosting`, a `Person`), one
   * object or several. Serialised as-is into a `<script type="application/ld+json">`.
   */
  structuredData?: Record<string, unknown> | readonly Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = '/og-default.png',
  noindex = false,
  hideChatDock = false,
  holdVeil = false,
  article,
  structuredData,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.handle}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const ogImage = absolute(image, SITE.url);
---

<!doctype html>
<html lang={SITE.locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {
      SITE.googleSiteVerification && (
        <meta name="google-site-verification" content={SITE.googleSiteVerification} />
      )
    }

    <meta property="og:type" content={article ? 'article' : 'website'} />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.updated && (
            <meta property="article:modified_time" content={article.updated.toISOString()} />
          )}
          <meta property="article:author" content={SITE.name} />
          {(article.tags ?? []).map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      structuredData && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
        />
      )
    }

    {
      /*
      Runs before first paint so the stored theme is applied with no flash.
      Inlined on purpose: an external module would arrive too late. Kept tiny
      and dependency-free — it mirrors `src/lib/theme.ts`.
    */
    }
    <script is:inline>
      (function () {
        document.documentElement.classList.remove('no-js');
        try {
          var t = localStorage.getItem('coronring:theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (e) {
          /* localStorage unavailable; fall through to system preference. */
        }
      })();
    </script>
  </head>

  <body class="min-h-dvh">
    <Veil hold={holdVeil} />
    <Backdrop />
    <Sidebar />

    <!-- Offset from the fixed rail; top padding clears the mobile bar. -->
    <div class="rail-offset flex min-h-dvh flex-col pt-14 lg:pt-0">
      <main id="main" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>

    {
      /*
      `client:idle` — the dock is never the reason someone opened the page, so
      it hydrates once the main thread is free rather than competing with the
      content for it. Collapsed, it makes no network requests at all.
    */
    }
    {!hideChatDock && <ChatDock client:idle />}

    {
      /*
      Last in the body: it looks the fragment's target up by id, so every
      section has to be parsed before it runs.
    */
    }
    <HashLanding />
  </body>
</html>
