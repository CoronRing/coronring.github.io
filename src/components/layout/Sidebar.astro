---
/**
 * Sidebar — the collapsed navigation rail that expands on hover.
 *
 * At rest it is an icon column (`--rail-w`, 4.5rem); on hover or keyboard
 * focus it widens to `--rail-w-open` (16rem) and the labels fade in. The
 * *content offset never changes* — page layout is padded by the collapsed
 * width only, so expanding overlays rather than reflows. Reflowing the whole
 * page on a hover would be both jarring and expensive.
 *
 * Labels are always in the DOM (never `display:none`) so screen readers and
 * find-in-page always see them; they are hidden visually via opacity/width on
 * the rail, not removed.
 *
 * On the home page the rail doubles as a scroll-spy: `data-spy` links mark
 * themselves current as their section passes the viewport middle.
 */
import { SITE } from '../../data/site';
import { href, isActive } from '../../lib/url';
import Icon from '../ui/Icon.astro';
import Mark from '../ui/Mark.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const onHome = path === '/' || path === '';
---

<a
  href="#main"
  class="bg-accent-fill text-accent-on-fill sr-only rounded-sm px-4 py-2 text-sm font-medium focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[110]"
>
  Skip to content
</a>

{/* ── Mobile top bar (below lg) ─────────────────────────────────── */}
<div
  class="bg-ground/85 border-line fixed inset-x-0 top-0 z-50 flex h-14 items-center justify-between border-b px-4 backdrop-blur-xl lg:hidden"
>
  <a href={href('/')} class="flex items-center gap-2.5" aria-label={`${SITE.name}, home`}>
    <Mark size={24} class="text-accent" />
    <span class="text-[13px] font-semibold tracking-tight">{SITE.handle}</span>
  </a>

  <div class="flex items-center gap-1">
    <ThemeToggle />
    <button
      type="button"
      id="nav-open"
      class="text-muted hover:text-fg grid size-9 place-items-center rounded-md transition-colors"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <Icon name="menu" size={18} />
    </button>
  </div>
</div>

{/* ── Desktop rail (lg and up) ──────────────────────────────────── */}
<aside
  data-rail
  class="group/rail border-line bg-surface/95 fixed inset-y-0 left-0 z-50 hidden w-[var(--rail-w)] flex-col overflow-hidden border-r backdrop-blur-xl transition-[width] duration-[var(--dur-base)] ease-[var(--ease-out)] hover:w-[var(--rail-w-open)] hover:shadow-[var(--shadow-lift)] lg:flex"
  aria-label="Primary"
>
  {/* Page progress, pinned to the rail's trailing edge. */}
  <span
    aria-hidden="true"
    data-scroll-progress
    class="scroll-progress bg-accent-fill absolute inset-y-0 right-0 z-10 w-[2px]"></span>
  <!-- Wordmark -->
  <a
    href={href('/')}
    class="group border-line flex h-16 shrink-0 items-center gap-3 border-b px-[1.0625rem]"
    aria-label={`${SITE.name}, home`}
  >
    <Mark
      size={30}
      class="text-accent transition-transform duration-[var(--dur-slow)] ease-[var(--ease-out)] group-hover:rotate-[20deg]"
    />
    <span class="rail-label flex flex-col leading-none whitespace-nowrap">
      <span class="display text-base">{SITE.handle}</span>
      <span class="eyebrow mt-1.5 text-[9px]">{SITE.role}</span>
    </span>
  </a>

  <!-- Primary navigation -->
  <nav class="flex-1 overflow-x-hidden overflow-y-auto py-3">
    <ul>
      {
        SITE.nav.map((item) => {
          const active = isActive(path, item.href);
          const spy = onHome && item.section;
          return (
            <li>
              <a
                href={spy ? `#${item.section}` : href(item.href)}
                data-spy={spy ? item.section : undefined}
                aria-current={active && !onHome ? 'page' : undefined}
                class:list={[
                  'nav-item relative flex h-12 items-center gap-4 px-[1.375rem] text-sm whitespace-nowrap transition-colors duration-[var(--dur-fast)]',
                  active && !onHome
                    ? 'text-fg bg-raised is-current'
                    : 'text-muted hover:text-fg hover:bg-raised/60',
                ]}
              >
                {/* Active marker: the reference's left border. */}
                <span
                  aria-hidden="true"
                  class="marker bg-accent-fill absolute inset-y-0 left-0 w-[3px] scale-y-0 transition-transform duration-[var(--dur-base)]"
                />
                <Icon name={item.icon} size={19} class="shrink-0" />
                <span class="rail-label flex-1">{item.label}</span>
                <span class="rail-label text-faint font-mono text-[10px]">{item.index}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <!-- Footer: CTA, socials, theme -->
  <div class="border-line shrink-0 border-t px-[1.0625rem] py-4">
    <a
      href={SITE.cta.href}
      class="bg-accent-fill text-accent-on-fill flex h-[1.875rem] items-center justify-center gap-2 rounded-sm text-sm font-semibold whitespace-nowrap transition-opacity hover:opacity-85"
    >
      <Icon name="mail" size={15} class="shrink-0" />
      <span class="rail-label">{SITE.cta.label}</span>
    </a>

    <div class="rail-label mt-3 flex items-center justify-between">
      <ul class="flex gap-1">
        {
          SITE.social.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener noreferrer"
                class="text-faint hover:text-accent grid size-8 place-items-center rounded-md transition-colors"
                aria-label={s.label}
                title={s.label}
              >
                <Icon name={s.icon} size={15} />
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </div>
</aside>

{/* ── Mobile drawer ─────────────────────────────────────────────── */}
<div
  id="mobile-nav"
  hidden
  class="fixed inset-0 z-[60] lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <div data-nav-scrim class="absolute inset-0 bg-[var(--c-overlay)] backdrop-blur-sm"></div>

  <div
    class="bg-surface border-line absolute inset-y-0 left-0 flex w-[min(20rem,86vw)] flex-col border-r"
  >
    <div class="border-line flex h-14 items-center justify-between border-b px-4">
      <span class="eyebrow">Navigation</span>
      <button
        type="button"
        id="nav-close"
        class="text-muted hover:text-fg grid size-9 place-items-center rounded-md transition-colors"
        aria-label="Close navigation"
      >
        <Icon name="close" size={18} />
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto py-2">
      <ul>
        {
          SITE.nav.map((item) => {
            const active = isActive(path, item.href);
            return (
              <li>
                <a
                  href={onHome && item.section ? `#${item.section}` : href(item.href)}
                  aria-current={active && !onHome ? 'page' : undefined}
                  class:list={[
                    'relative flex items-center gap-3.5 px-5 py-3.5',
                    active && !onHome
                      ? 'bg-raised text-fg before:bg-accent-fill before:absolute before:inset-y-0 before:left-0 before:w-[3px] before:content-[""]'
                      : 'text-muted',
                  ]}
                >
                  <Icon name={item.icon} size={18} />
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm">{item.label}</span>
                    <span class="text-faint block text-[11px]">{item.blurb}</span>
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="border-line border-t px-5 py-4">
      <a
        href={SITE.cta.href}
        class="bg-accent-fill text-accent-on-fill flex h-11 items-center justify-center gap-2 rounded-sm text-sm font-semibold"
      >
        {SITE.cta.label}
        <Icon name="arrow-right" size={15} />
      </a>
      <ul class="mt-4 flex gap-2">
        {
          SITE.social.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener noreferrer"
                class="border-line text-muted grid size-9 place-items-center rounded-md border"
                aria-label={s.label}
              >
                <Icon name={s.icon} size={15} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<style>
  /*
   * Labels stay in the DOM at all times (assistive tech and find-in-page need
   * them); the rail hides them visually by collapsing width and opacity.
   * `visibility` is not used because it would remove them from the a11y tree.
   */
  .rail-label {
    opacity: 0;
    transform: translateX(-0.375rem);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  :global([data-rail]:hover) .rail-label,
  :global([data-rail]:has(:focus-visible)) .rail-label {
    opacity: 1;
    transform: none;
  }

  /*
   * Keyboard focus must expand the rail too, or tabbing into it lands on
   * unlabelled icons. `:has(:focus-visible)` rather than `:focus-within`:
   * the latter also fires on *mouse* clicks, so clicking the theme toggle
   * (which lives in the rail) left the rail pinned open after the cursor had
   * already moved away.
   */
  :global([data-rail]:has(:focus-visible)) {
    width: var(--rail-w-open);
  }

  /* Active marker grows from the centre when current. */
  .nav-item.is-current .marker,
  .nav-item[aria-current='true'] .marker {
    transform: scaleY(1);
  }
  .nav-item.is-current,
  .nav-item[aria-current='true'] {
    color: var(--c-text);
    background: var(--c-raised);
  }
</style>

<script>
  function initNav(): void {
    const drawer = document.getElementById('mobile-nav');
    const openBtn = document.getElementById('nav-open');
    const closeBtn = document.getElementById('nav-close');
    const scrim = drawer?.querySelector('[data-nav-scrim]');

    if (drawer && openBtn) {
      let lastFocused: HTMLElement | null = null;

      const setOpen = (open: boolean) => {
        drawer.hidden = !open;
        openBtn.setAttribute('aria-expanded', String(open));
        document.documentElement.style.overflow = open ? 'hidden' : '';

        if (open) {
          lastFocused = document.activeElement as HTMLElement | null;
          drawer.querySelector<HTMLElement>('a, button')?.focus();
        } else {
          lastFocused?.focus();
        }
      };

      openBtn.addEventListener('click', () => setOpen(true));
      closeBtn?.addEventListener('click', () => setOpen(false));
      scrim?.addEventListener('click', () => setOpen(false));
      drawer
        .querySelectorAll('a')
        .forEach((a) => a.addEventListener('click', () => setOpen(false)));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !drawer.hidden) setOpen(false);
      });

      window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
        if (e.matches && !drawer.hidden) setOpen(false);
      });
    }

    initScrollSpy();
  }

  /**
   * Scroll-spy for the single-flow home page.
   *
   * Uses a viewport-middle band rather than plain intersection: with
   * full-height sections, two are visible at once during a scroll and
   * "topmost intersecting" flickers between them. A thin band picks exactly
   * one section at a time.
   */
  function initScrollSpy(): void {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
    if (links.length === 0) return;

    const sections = links
      .map((link) => document.getElementById(link.dataset.spy ?? ''))
      .filter((el): el is HTMLElement => el !== null);
    if (sections.length === 0) return;

    const setCurrent = (id: string) => {
      links.forEach((link) => {
        const on = link.dataset.spy === id;
        link.classList.toggle('is-current', on);
        if (on) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setCurrent(entry.target.id);
        }
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );

    sections.forEach((section) => observer.observe(section));
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
