---
/**
 * Footer — a single instrument-readout strip.
 *
 * The sidebar already carries the sitemap, socials, and the call to action,
 * so repeating them here would be pure duplication. What is left is the one
 * thing the rail cannot show: build provenance. Baked at compile time, which
 * makes it a genuine "is this deploy live?" signal.
 */
import { SITE } from '../../data/site';

const builtAt = new Date().toISOString().slice(0, 16).replace('T', ' ');
const year = new Date().getFullYear();
---

<footer class="border-line mt-24 border-t">
  <div
    class="shell text-faint flex flex-col gap-3 py-6 font-mono text-[11px] sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {year} {SITE.name}</p>

    <dl class="flex flex-wrap items-center gap-x-5 gap-y-1">
      <div class="flex items-center gap-1.5">
        <dt class="sr-only">Status</dt>
        <dd class="text-ok inline-flex items-center gap-1.5">
          <span aria-hidden="true" class="size-1.5 rounded-full bg-current"></span>
          operational
        </dd>
      </div>
      <div class="flex gap-1.5">
        <dt>compiled</dt>
        <dd class="tabular">{builtAt}Z</dd>
      </div>
      <div class="flex gap-1.5">
        <dt class="sr-only">Source</dt>
        <dd>
          <a
            href={`https://github.com/${SITE.repo}`}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-accent transition-colors">source</a
          >
        </dd>
      </div>
    </dl>
  </div>
</footer>
