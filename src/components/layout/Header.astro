---
/**
 * Header — sticky top bar: wordmark, primary nav, theme toggle, mobile drawer.
 *
 * Two navs are rendered from the same `SITE.nav` source: a horizontal row for
 * >=lg, and a full-screen drawer below it. One data source, no drift.
 */
import { SITE } from '../../data/site';
import { href, isActive } from '../../lib/url';
import Icon from '../ui/Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
---

<a
  href="#main"
  class="bg-accent sr-only rounded-md px-4 py-2 text-sm font-medium text-[var(--c-accent-contrast)] focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60]"
>
  Skip to content
</a>

<header
  id="site-header"
  data-scrolled="false"
  class="data-[scrolled=true]:border-line sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,backdrop-filter] duration-[var(--dur-base)] data-[scrolled=true]:bg-[color-mix(in_srgb,var(--c-ground)_82%,transparent)] data-[scrolled=true]:backdrop-blur-xl"
>
  <div class="shell flex h-16 items-center justify-between gap-6">
    <!-- Wordmark -->
    <a href={href('/')} class="group flex items-center gap-2.5" aria-label={`${SITE.name} — home`}>
      <span
        aria-hidden="true"
        class="border-accent group-hover:bg-accent-soft relative grid size-7 place-items-center rounded-full border transition-colors duration-[var(--dur-base)]"
      >
        <span class="bg-accent size-1.5 rounded-full"></span>
      </span>
      <span class="flex flex-col leading-none">
        <span class="text-[13px] font-semibold tracking-tight">{SITE.handle}</span>
        <span class="eyebrow mt-1 text-[9px]">{SITE.role}</span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          SITE.nav.map((item) => {
            const active = isActive(path, item.href);
            return (
              <li>
                <a
                  href={href(item.href)}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'group relative flex items-baseline gap-2 rounded-md px-3 py-2 text-sm transition-colors duration-[var(--dur-fast)]',
                    active ? 'text-fg' : 'text-muted hover:text-fg',
                  ]}
                >
                  <span class="text-accent font-mono text-[10px] opacity-0 transition-opacity duration-[var(--dur-fast)] group-hover:opacity-100 aria-[current=page]:opacity-100">
                    {item.index}
                  </span>
                  <span>{item.label}</span>
                  {active && (
                    <span aria-hidden="true" class="bg-accent absolute inset-x-3 -bottom-px h-px" />
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 sm:flex">
        {
          SITE.social.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener noreferrer"
                class="text-muted hover:text-fg hover:bg-raised grid size-9 place-items-center rounded-md transition-colors duration-[var(--dur-fast)]"
                aria-label={s.label}
                title={s.label}
              >
                <Icon name={s.icon} size={16} />
              </a>
            </li>
          ))
        }
      </ul>

      <span aria-hidden="true" class="bg-line mx-1 hidden h-5 w-px sm:block"></span>

      <ThemeToggle />

      <button
        type="button"
        id="nav-open"
        class="text-muted hover:text-fg hover:bg-raised grid size-9 place-items-center rounded-md transition-colors lg:hidden"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<div
  id="mobile-nav"
  hidden
  class="fixed inset-0 z-[55] lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <div data-nav-scrim class="absolute inset-0 bg-[var(--c-overlay)] backdrop-blur-sm"></div>

  <div class="bg-surface border-line absolute inset-x-0 top-0 border-b shadow-[var(--shadow-lift)]">
    <div class="shell flex h-16 items-center justify-between">
      <span class="eyebrow">Navigation</span>
      <button
        type="button"
        id="nav-close"
        class="text-muted hover:text-fg hover:bg-raised grid size-9 place-items-center rounded-md transition-colors"
        aria-label="Close navigation"
      >
        <Icon name="close" size={18} />
      </button>
    </div>

    <nav aria-label="Mobile" class="shell pb-6">
      <ul class="divide-line divide-y">
        {
          SITE.nav.map((item) => {
            const active = isActive(path, item.href);
            return (
              <li>
                <a
                  href={href(item.href)}
                  aria-current={active ? 'page' : undefined}
                  class="group flex items-center gap-4 py-4"
                >
                  <span
                    class:list={['font-mono text-[11px]', active ? 'text-accent' : 'text-faint']}
                  >
                    {item.index}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class:list={['block text-base', active ? 'text-accent' : 'text-fg']}>
                      {item.label}
                    </span>
                    <span class="text-faint block text-xs">{item.blurb}</span>
                  </span>
                  <Icon name="arrow-right" size={15} class="text-faint" />
                </a>
              </li>
            );
          })
        }
      </ul>

      <ul class="mt-6 flex gap-2">
        {
          SITE.social.map((s) => (
            <li>
              <a
                href={s.href}
                target={s.href.startsWith('mailto:') ? undefined : '_blank'}
                rel="noopener noreferrer"
                class="border-line text-muted hover:text-fg grid size-10 place-items-center rounded-md border transition-colors"
                aria-label={s.label}
              >
                <Icon name={s.icon} size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<script>
  function initHeader(): void {
    const header = document.getElementById('site-header');
    const drawer = document.getElementById('mobile-nav');
    const openBtn = document.getElementById('nav-open');
    const closeBtn = document.getElementById('nav-close');
    const scrim = drawer?.querySelector('[data-nav-scrim]');
    if (!header || !drawer || !openBtn) return;

    // Solidify the header only once the page has actually scrolled.
    const onScroll = () => {
      header.dataset.scrolled = String(window.scrollY > 8);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    let lastFocused: HTMLElement | null = null;

    const setOpen = (open: boolean) => {
      drawer.hidden = !open;
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';

      if (open) {
        lastFocused = document.activeElement as HTMLElement | null;
        drawer.querySelector<HTMLElement>('a, button')?.focus();
      } else {
        lastFocused?.focus();
      }
    };

    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn?.addEventListener('click', () => setOpen(false));
    scrim?.addEventListener('click', () => setOpen(false));
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) setOpen(false);
    });

    // Returning to a wide viewport should never leave the drawer stuck open.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches && !drawer.hidden) setOpen(false);
    });
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
