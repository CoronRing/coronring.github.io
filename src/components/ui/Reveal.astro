---
/**
 * Reveal — wraps children in a scroll-triggered entrance.
 *
 * Two variants:
 *   `rise` (default) — fade and lift. The workhorse; safe on any block.
 *   `wipe`           — a clip-path sweep left-to-right, for display headings.
 *                      Reads as type being *set* rather than faded in, which
 *                      suits the instrument aesthetic. Reserve it for one or
 *                      two elements per section; on body copy it is showy and
 *                      slows reading.
 *
 * Progressive enhancement, four ways:
 *   1. `.no-js` (set on <html> until the shell script clears it) shows content.
 *   2. A missing IntersectionObserver reveals everything immediately.
 *   3. A 2s safety timeout reveals anything *already on screen* that the
 *      observer never reached. An element stuck at `opacity: 0` forever is far
 *      worse than a missed animation, but the net has to be cast narrowly:
 *      revealing everything, including the sections a visitor has not scrolled
 *      to yet, marks the whole page shown two seconds after load and there is
 *      nothing left to animate on the way down.
 *   4. `prefers-reduced-motion` collapses the transition in global.css.
 *
 * The observer is registered once per page, not once per component.
 */
interface Props {
  /** Stagger in milliseconds, for sequencing siblings. */
  delay?: number;
  variant?: 'rise' | 'wipe';
  as?: 'div' | 'section' | 'li' | 'article' | 'header';
  class?: string;
}

const { delay = 0, variant = 'rise', as: Tag = 'div', class: className } = Astro.props;
---

<Tag
  data-reveal={variant}
  class:list={className}
  style={delay ? `--reveal-delay:${delay}ms` : undefined}
>
  <slot />
</Tag>

<script>
  // Guarded so repeated component use doesn't attach duplicate observers.
  const KEY = '__revealObserverAttached';
  const w = window as Window & { [KEY]?: boolean };

  if (!w[KEY]) {
    w[KEY] = true;

    const show = (el: Element) => el.setAttribute('data-shown', 'true');

    const attach = () => {
      const targets = document.querySelectorAll('[data-reveal]:not([data-shown])');

      if (!('IntersectionObserver' in window)) {
        targets.forEach(show);
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            show(entry.target);
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
      );

      targets.forEach((el) => observer.observe(el));

      /*
       * Safety net, scoped to the viewport.
       *
       * `[data-reveal]` starts hidden, so anything the observer fails to reach
       * stays invisible forever — but "reveal everything still pending" is the
       * wrong repair. It fires two seconds after load, when the visitor is
       * still on the first screen, and marks every section below the fold as
       * already shown; scrolling down then finds a page that has quietly
       * finished animating without them.
       *
       * So only what is on screen, or above it, is forced. Anything genuinely
       * below the fold stays with the observer, which is the thing that is
       * supposed to reveal it.
       */
      window.setTimeout(() => {
        document.querySelectorAll('[data-reveal]:not([data-shown])').forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) show(el);
        });
      }, 2000);
    };

    attach();
    // Astro's client-side router swaps the DOM; re-scan after each navigation.
    document.addEventListener('astro:page-load', attach);
  }
</script>
