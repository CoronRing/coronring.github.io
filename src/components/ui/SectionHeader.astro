---
/**
 * SectionHeader — the repeating "chapter marker" that gives every page the
 * same rhythm: mono index, hairline rule, title, optional lede and action.
 */
interface Props {
  /** Two-digit HUD index, e.g. "01". */
  index?: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  /** Heading level. Sections default to h2; use h1 only for a page title. */
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}

const { index, eyebrow, title, lede, as: Tag = 'h2', class: className } = Astro.props;
const hasAction = Astro.slots.has('action');
---

<header class:list={['mb-8 sm:mb-10', className]}>
  {
    (index || eyebrow) && (
      <div class="mb-4 flex items-center gap-3">
        {index && <span class="eyebrow text-accent tabular">{index}</span>}
        {index && eyebrow && <span aria-hidden="true" class="bg-line-strong h-px w-6" />}
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <span aria-hidden="true" class="bg-line h-px flex-1" />
      </div>
    )
  }

  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="max-w-[var(--prose-max)]">
      <Tag
        class:list={[
          'text-balance',
          Tag === 'h1' ? 'text-4xl sm:text-5xl lg:text-6xl' : 'text-2xl sm:text-3xl',
        ]}
      >
        {title}
      </Tag>
      {lede && <p class="text-muted mt-3 text-base leading-relaxed sm:text-lg">{lede}</p>}
    </div>

    {
      hasAction && (
        <div class="shrink-0">
          <slot name="action" />
        </div>
      )
    }
  </div>
</header>
