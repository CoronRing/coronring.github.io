---
/** Tag — compact mono chip for tech labels, statuses, and categories. */
interface Props {
  variant?: 'neutral' | 'accent' | 'signal' | 'ok' | 'warn';
  /** Prefix a small filled dot. Reads as a status light. */
  dot?: boolean;
  class?: string;
}

const { variant = 'neutral', dot = false, class: className } = Astro.props;

const VARIANT = {
  neutral: 'border-line text-muted bg-raised',
  accent: 'border-[var(--c-accent-ring)] text-accent bg-accent-soft',
  signal: 'border-[var(--c-signal)]/35 text-signal bg-signal-soft',
  ok: 'border-ok/35 text-ok bg-ok/10',
  warn: 'border-warn/35 text-warn bg-warn/10',
} as const;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-sm border px-2 py-[3px]',
    'font-mono text-[11px] leading-none font-medium tracking-wide whitespace-nowrap',
    VARIANT[variant],
    className,
  ]}
>
  {dot && <span aria-hidden="true" class="size-1.5 rounded-full bg-current" />}
  <slot />
</span>
