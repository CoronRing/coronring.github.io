---
/**
 * Backdrop — the fixed atmospheric layer behind all page content.
 *
 * Four stacked decorative elements, back to front:
 *   1. blueprint grid  — structure, opacity scaled per theme
 *   2. aurora bloom    — the soft off-axis colour wash in the reference's
 *                        top-right corner; near-invisible in light, present
 *                        in dark (`--bloom-alpha`)
 *   3. horizon rule    — a single full-bleed hairline, the reference's most
 *                        recognisable piece of page furniture
 *   4. film grain      — SVG turbulence, kills banding across the bloom
 *
 * Fixed, `pointer-events-none`, and `aria-hidden`: it never intercepts input
 * and never reaches the accessibility tree. Rendered once, in BaseLayout.
 */
---

<div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
  <div class="grid-backdrop absolute inset-0"></div>

  <!-- Aurora bloom, anchored off the top-right corner. -->
  <div
    class="absolute top-[-25vh] right-[-15vw] h-[80vh] w-[70vw]"
    style="opacity: var(--bloom-alpha); background:
      radial-gradient(closest-side at 60% 40%, #2b6cb0 0%, transparent 70%),
      radial-gradient(closest-side at 35% 60%, #7a3fa8 0%, transparent 70%),
      radial-gradient(closest-side at 55% 75%, #1f7a63 0%, transparent 72%);
      filter: blur(60px);"
  >
  </div>

  <!-- Horizon: one hairline across the full width. -->
  <div class="bg-line absolute inset-x-0 top-[46vh] h-px opacity-60"></div>

  <svg class="absolute inset-0 h-full w-full" style="opacity: var(--noise-alpha);">
    <filter id="grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"
      ></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter="url(#grain)"></rect>
  </svg>
</div>
