---
/**
 * ParticleField — the interactive corona point cloud.
 *
 * Wraps the published ParticleWave engine (`@npmring/particle-wave`, built from
 * https://github.com/CoronRing/ParticleWave). The engine owns physics,
 * rendering, and pointer handling; this component owns what is specific to this
 * site:
 *
 *  - **Theming.** Colour, alpha and radius come from live CSS tokens and are
 *    re-pushed when the theme changes.
 *  - **Ambient motion.** Slow rotation plus a per-particle wander, so the
 *    cloud lives without a cursor on it. Both are engine config now; an
 *    earlier revision bolted a curl-noise force on from here, which moved
 *    neighbouring points together and read as breathing rather than drift.
 *  - **Cost control.** Nothing loads until the canvas is near the viewport,
 *    and the simulation pauses off-screen or in a background tab.
 *  - **Graceful absence.** Decorative: any failure leaves the page intact.
 *
 * ## Pointer events
 *
 * The canvas must receive them or the cloud is dead to the cursor — an
 * earlier revision set `pointer-events-none` on this wrapper *and* on the
 * hero container, which is why interaction silently did nothing. The wrapper
 * stays transparent to hit-testing so it never blocks page content; the
 * canvas opts back in when `interactive`.
 */
import { href } from '../../lib/url';

interface Props {
  /** Path to the `.pwcloud` asset, relative to the site root. */
  src?: string;
  /**
   * Whether the canvas accepts pointer input. Off for decorative instances
   * that sit under text; on for the hero.
   */
  interactive?: boolean;
  class?: string;
  style?: string;
}

const { src = '/clouds/corona.pwcloud', interactive = true, class: className, style } = Astro.props;
const cloudUrl = href(src);
---

<div
  aria-hidden="true"
  data-particle-field
  data-cloud={cloudUrl}
  data-interactive={interactive ? '1' : '0'}
  style={style}
  class:list={['pointer-events-none absolute inset-0 overflow-hidden', className]}
>
  {
    /*
    No fade-in, deliberately. A previous `transition-opacity` left the cloud
    permanently washed out wherever the animation clock stalls (headless
    capture, some low-power modes) — measured at ~35% of intended contrast.
    The canvas is transparent until the first frame paints, so there is no
    wrong state to hide.
  */
  }
  <canvas
    data-particle-canvas
    class:list={['size-full', interactive && 'pointer-events-auto cursor-crosshair']}></canvas>
</div>

<script>
  import ParticleWave from '@npmring/particle-wave';

  /** Current value of a CSS custom property on :root. */
  function token(name: string, fallback: string): string {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  async function initField(host: HTMLElement): Promise<void> {
    const canvas = host.querySelector<HTMLCanvasElement>('[data-particle-canvas]');
    const src = host.dataset.cloud;
    if (!canvas || !src) return;

    const interactive = host.dataset.interactive === '1';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let instance: Awaited<ReturnType<typeof ParticleWave.init>> | null = null;
    try {
      instance = await ParticleWave.init(canvas, {
        src,
        padding: 0.08,
        scaleMode: 'fit',

        // Colour, alpha and radius are theme tokens — see the note on
        // --particle-size in tokens.css for why the themes differ.
        particleColor: token('--c-particle', '#ffffff'),
        particleOpacity: Number(token('--particle-opacity', '0.85')),
        particleSize: Number(token('--particle-size', '1.8')),
        particleSizeWeight: 0.9,
        particleOpacityWeight: 0.8,

        // Loose spring + moderate damping. Particles lag slightly behind the
        // rotating rest frame, which reads as drag and keeps the spin from
        // looking like a rigid turntable.
        springK: 1.9,
        damping: 3.4,

        // Always-on motion, both applied to the rest frame by the engine.
        // One revolution every ~2.3 minutes: present when you watch for it,
        // never competing with the text beside it.
        restSpin: 0.045,
        driftAmplitude: 6,
        driftSpeed: 0.5,

        // The glyph holds still; only the corona turns. Rotating everything
        // would put the G upside down for half of every revolution. Dust
        // trails the flares, which reads as depth rather than one rigid disc.
        // Indices are defined in scripts/generate-cloud.mjs.
        spinWeightByGroup: {
          0: 0, // glyph ring
          1: 0, // glyph bar
          2: 0, // glyph core
          3: 1, // flares
          4: 0.55, // dust
        },

        mouseEnabled: interactive && !reduce,
        mouseMode: 'repel',
        mouseStrength: 58,
        interactionRadius: 170,
        touchEnabled: false,

        waveEnabled: interactive && !reduce,
        waveSpeed: 340,
        waveStrength: 110,
        rippleCount: 2,
      });
    } catch (err) {
      // Decorative: a failure here must never surface to the visitor.
      console.warn('[ParticleField] disabled:', err);
      return;
    }

    if (reduce) {
      // Render exactly one static frame, then stop. Pausing immediately would
      // cancel the rAF the engine schedules in its constructor and leave the
      // canvas blank.
      requestAnimationFrame(() => requestAnimationFrame(() => instance?.pause()));
      return;
    }

    // Pause when off-screen or backgrounded — an invisible rAF loop is pure
    // battery cost.
    let onScreen = true;
    const sync = () => {
      if (onScreen && !document.hidden) instance?.resume();
      else instance?.pause();
    };

    const vis = new IntersectionObserver(
      ([entry]) => {
        onScreen = entry?.isIntersecting ?? true;
        sync();
      },
      { rootMargin: '120px' },
    );
    vis.observe(host);
    document.addEventListener('visibilitychange', sync);

    // Re-theme on toggle, or when the OS preference changes under "system".
    const retheme = () =>
      instance?.setConfig({
        particleColor: token('--c-particle', '#ffffff'),
        particleOpacity: Number(token('--particle-opacity', '0.85')),
        particleSize: Number(token('--particle-size', '1.8')),
      });

    new MutationObserver(retheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', retheme);
  }

  function mount(): void {
    document.querySelectorAll<HTMLElement>('[data-particle-field]').forEach((host) => {
      if (host.dataset.mounted === '1') return;
      host.dataset.mounted = '1';

      // Defer the cloud fetch and the engine until the canvas is close.
      if (!('IntersectionObserver' in window)) {
        void initField(host);
        return;
      }
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          void initField(host);
        },
        { rootMargin: '200px' },
      );
      io.observe(host);
    });
  }

  mount();
  document.addEventListener('astro:page-load', mount);
</script>
