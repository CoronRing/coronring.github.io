# build output
dist/
.output/

# Upload-ready Docker build contexts, written by infra/package_zip.py. Derived
# entirely from tracked source, so the zips themselves are not worth tracking.
dist-docker/

# Source archives for a build-from-source host, written by `git archive`.
# Same reasoning: derived from a commit, so the commit is the real record.
dist-source/

# generated types
.astro/

# dependencies
node_modules/

# logs
.log/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment
.env
.env.production
.env*.local

# Generated onto the host by infra/configure.py from the operator's local
# .env. Should never exist here, and must never be committable if it does.
infra/chat.env

# agent / scratch work — never tracked
.agent_temp/

# editor + OS
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Python backend (backend/) and operator tooling (infra/)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Credentials, belt and braces — these live outside the repo, and a stray copy
# landing here should never be committable.
*.pem
*.key
*.p12
id_rsa*
id_ed25519*
.oci/
